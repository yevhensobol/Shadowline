@using Microsoft.JSInterop
@using Shadowline.Core.Comms
@using Shadowline.Core.Ephemeris
@using Shadowline.Core.Sites
@using Shadowline.Core.Time
@implements IAsyncDisposable
@inherits LocalizedComponent
@inject IJSRuntime Js
@inject SiteViewCache Views

<div class="globe @(Embedded ? "embed" : null)">
    <canvas @ref="canvas" tabindex="0" aria-label="@L["explore.hint"]"></canvas>
    <div @ref="overlay" class="globe-overlay"></div>
    @if (state == State.Loading)
    {
        <div class="globe-status globe-loading" role="status">
            <svg class="globe-spin" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" /><circle cx="60" cy="60" r="34" fill="#070a10" /><path d="M60 26A34 34 0 0 0 60 94A12 34 0 0 0 60 26Z" fill="#f2a33a" /></svg>
            <span>@L["explore.loading3d"]</span>
        </div>
    }
    else if (state == State.Failed)
    {
        <p class="globe-status">@L["explore.no3d"] <a href="plan/sky">@L["nav.planner"]</a></p>
    }
</div>

@code {
    private enum State
    {
        Loading,
        Ready,
        Failed,
    }

    public sealed record SceneSite(string Id, string Name, double Lat, double Lon, string Kind);

    public sealed record StationMark(string Id, string Name, double Lat, double Lon, bool Up);

    public sealed record LayerProbe(double Sun, double Earth, bool Dark, double? Slope, double? Ml = null, double? MaxK = null, double? Ice = null);

    public sealed record RouteData(int Count, double[] DistanceKm, double[] ElevationM, double[] SlopeDeg, double[] Sun, double[] Earth, bool[] Dark, bool[] Waypoint, double[][]? Points = null);

    private const string EngineVersion = "42";

    public bool IsReady => state == State.Ready;

    private ElementReference canvas;
    private ElementReference overlay;
    private IJSObjectReference? module;
    private IJSObjectReference? scene;
    private DotNetObjectReference<MoonGlobe>? self;
    private State state = State.Loading;
    private string sitesKey = string.Empty;
    private string? selectedKey;
    private int? sentCursor;
    private BodyEphemeris? sentEphemeris;
    private bool regionsSent;
    private bool? sentShowRegions;
    private string? stoodId;
    private string? stationsKey;

    [Parameter, EditorRequired]
    public IReadOnlyList<SceneSite> Sites { get; set; } = [];

    [Parameter]
    public Site? Selected { get; set; }

    [Parameter]
    public int Cursor { get; set; }

    [Parameter, EditorRequired]
    public BodyEphemeris Ephemeris { get; set; } = default!;

    [Parameter, EditorRequired]
    public TimeGrid Grid { get; set; } = default!;

    [Parameter]
    public EventCallback<string> SiteSelected { get; set; }

    [Parameter]
    public IReadOnlyList<Shadowline.Data.ArtemisRegion>? Regions { get; set; }

    [Parameter]
    public bool ShowRegions { get; set; }

    [Parameter]
    public bool Embedded { get; set; }

    [Parameter]
    public Site? StandAt { get; set; }

    [Parameter]
    public int EyeMeters { get; set; } = 50;

    [Parameter]
    public object? Labels { get; set; }

    [Parameter]
    public EventCallback<string> RegionSelected { get; set; }

    [Parameter]
    public EventCallback<(double Lat, double Lon)> PointSelected { get; set; }

    [Parameter]
    public EventCallback Ready { get; set; }

    [Parameter]
    public string Quality { get; set; } = "auto";

    [Parameter]
    public EventCallback<RouteData> RouteChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                self = DotNetObjectReference.Create(this);
                module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/moonscene.js?v=" + EngineVersion);
                scene = await module.InvokeAsync<IJSObjectReference>("init", canvas, overlay, self, new { @base = "img/scene/", quality = Quality, units = Units() });
                state = State.Ready;
                StateHasChanged();
                await Ready.InvokeAsync();
            }
            catch (JSException)
            {
                state = State.Failed;
                StateHasChanged();
                return;
            }
        }

        await PushAsync();
    }

    private object Units() => new { m = L["common.unit.m"], km = L["common.unit.km"], sdemTitle = L["explore.sdemTitle"], sdemPhoto = L["explore.sdemPhoto"], sdemRelief = L["explore.sdemRelief"], sdemPhotoHint = L["explore.sdemPhotoHint"], sdemReliefHint = L["explore.sdemReliefHint"] };

    private string? sentLanguage;

    private async Task PushAsync()
    {
        if (module is null || state != State.Ready)
        {
            return;
        }

        if (sentLanguage != L.Language)
        {
            sentLanguage = L.Language;
            await module.InvokeVoidAsync("setUnits", Units());
        }

        var key = string.Join('|', Sites.Select(site => site.Id));
        if (key != sitesKey)
        {
            sitesKey = key;
            await scene!.InvokeVoidAsync("setSites", Sites);
        }

        if (!regionsSent && Regions is { Count: > 0 } regions)
        {
            regionsSent = true;
            sentShowRegions = ShowRegions;
            await scene!.InvokeVoidAsync("setRegions", regions, ShowRegions);
        }
        else if (regionsSent && sentShowRegions != ShowRegions)
        {
            sentShowRegions = ShowRegions;
            await scene!.InvokeVoidAsync("showRegions", ShowRegions);
        }

        if (Selected is { } site && site.Id != selectedKey)
        {
            selectedKey = site.Id;
            await scene!.InvokeVoidAsync("setSelected", site.Id, site.LatitudeDeg, site.LongitudeEastDeg);
        }

        if (StandAt is { } stand && StandKey(stand) != stoodId)
        {
            stoodId = StandKey(stand);
            await StandAsync(stand, EyeMeters, Labels ?? new { });
        }

        if (sentCursor != Cursor || !ReferenceEquals(sentEphemeris, Ephemeris))
        {
            sentCursor = Cursor;
            sentEphemeris = Ephemeris;
            var sun = Ephemeris.Sun(Cursor);
            var earth = Ephemeris.Earth(Cursor);
            await scene!.InvokeVoidAsync(
                "setTime",
                Grid.At(Cursor).UtcDateTime.ToString("O"),
                new[] { sun.X, sun.Y, sun.Z },
                new[] { earth.X, earth.Y, earth.Z });
        }

        var elevations = DeepSpaceNetwork.Elevations(Ephemeris, Cursor);
        var stations = DeepSpaceNetwork.Stations
            .Select((station, i) => new StationMark(station.Id, L.Place(station.Name), station.LatitudeDeg, station.LongitudeEastDeg, elevations[i] >= DeepSpaceNetwork.MinElevationDeg))
            .ToList();
        var stationKey = L.Language + string.Concat(stations.Select(station => station.Up ? '1' : '0'));
        if (stationKey != stationsKey)
        {
            stationsKey = stationKey;
            await scene!.InvokeVoidAsync("setStations", stations);
        }
    }

    public async Task FlyToAsync(double lat, double lon, double rangeKm, double? tiltDeg = null)
    {
        if (module is not null && state == State.Ready)
        {
            await scene!.InvokeVoidAsync("flyTo", lat, lon, rangeKm, tiltDeg, null, null);
        }
    }

    private string StandKey(Site site) => site.Id + (Views.TerrainFor(site.Id) is null ? string.Empty : "+terrain");

    public async Task<bool> StandAsync(Site site, int eyeMeters, object labels)
    {
        if (module is null || state != State.Ready)
        {
            return false;
        }

        var custom = site.Id.StartsWith(CustomSite.Prefix, StringComparison.Ordinal);
        var catalogId = custom ? null : site.Id;
        var terrain = custom ? Views.TerrainFor(site.Id) : null;
        await scene!.InvokeVoidAsync("standAt", catalogId, site.LatitudeDeg, site.LongitudeEastDeg, eyeMeters, labels, terrain?.ElevationM ?? site.ElevationM, terrain?.Tile, terrain?.Horizon);
        return true;
    }

    public async Task LeaveSurfaceAsync()
    {
        if (module is not null && state == State.Ready)
        {
            await scene!.InvokeVoidAsync("leaveSurface");
        }
    }

    public async Task TurnToAsync(string target, double? fovDeg = null)
    {
        if (module is not null && state == State.Ready)
        {
            await scene!.InvokeVoidAsync("turnTo", target, fovDeg);
        }
    }

    public async Task SetEyeAsync(int meters)
    {
        if (module is not null && state == State.Ready)
        {
            await scene!.InvokeVoidAsync("setEye", meters);
        }
    }

    public async Task<bool> SetLayerAsync(string mode, object labels)
    {
        if (module is null || state != State.Ready)
        {
            return false;
        }

        return await scene!.InvokeAsync<bool>("setLayer", mode, labels);
    }

    public async Task<bool> SetGridAsync(bool on)
    {
        if (module is null || state != State.Ready)
        {
            return false;
        }

        return await scene!.InvokeAsync<bool>("setGrid", on);
    }

    public async Task<bool> SetNowMapAsync(byte[]? data, int size, double halfExtentM)
    {
        if (module is null || state != State.Ready)
        {
            return false;
        }

        return await scene!.InvokeAsync<bool>("setNowMap", data, size, halfExtentM);
    }

    public async Task<LayerProbe?> ProbeAsync(double lat, double lon)
    {
        if (module is null || state != State.Ready || lat > -80)
        {
            return null;
        }

        try
        {
            return await scene!.InvokeAsync<LayerProbe?>("probe", lat, lon);
        }
        catch (JSException)
        {
            return null;
        }
    }

    public async Task<string?> RecordAsync(string title, IReadOnlyList<string> lines, string fileName, int seconds)
    {
        if (scene is null || state != State.Ready)
        {
            return null;
        }

        return await scene.InvokeAsync<string?>("record", title, lines, fileName, seconds);
    }

    public async Task StopRecordingAsync()
    {
        if (scene is not null && state == State.Ready)
        {
            await scene.InvokeVoidAsync("stopRecording");
        }
    }

    public async Task<bool> SnapshotAsync(string title, IReadOnlyList<string> lines, string fileName)
    {
        if (module is null || state != State.Ready)
        {
            return false;
        }

        return await scene!.InvokeAsync<bool>("snapshot", title, lines, fileName);
    }

    public async Task<bool> SetRouteModeAsync(bool on)
    {
        if (module is null || state != State.Ready)
        {
            return false;
        }

        return await scene!.InvokeAsync<bool>("setRouteMode", on);
    }

    public async Task UndoWaypointAsync()
    {
        if (module is not null && state == State.Ready)
        {
            await scene!.InvokeVoidAsync("undoWaypoint");
        }
    }

    public async Task ClearRouteAsync()
    {
        if (module is not null && state == State.Ready)
        {
            await scene!.InvokeVoidAsync("clearRoute");
        }
    }

    [JSInvokable]
    public Task OnRouteChanged(RouteData route) => RouteChanged.InvokeAsync(route);

    [JSInvokable]
    public Task OnSitePicked(string id) => SiteSelected.InvokeAsync(id);

    [JSInvokable]
    public Task OnRegionPicked(string code) => RegionSelected.InvokeAsync(code);

    [JSInvokable]
    public Task OnPointPicked(double lat, double lon) => PointSelected.InvokeAsync((lat, lon));

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                if (scene is not null)
                {
                    await scene.InvokeVoidAsync("dispose");
                    await scene.DisposeAsync();
                }

                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        self?.Dispose();
        base.Dispose();
    }
}
