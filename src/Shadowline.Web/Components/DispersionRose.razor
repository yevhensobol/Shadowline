@using System.Globalization
@using Shadowline.Core.Reports
@inherits LocalizedComponent

<figure class="rose">
    <div class="rose-tabs" role="group" aria-label="@L["rose.metric"]">
        @foreach (var key in Metrics)
        {
            <button type="button" class="chip" aria-pressed="@(metric == key ? "true" : "false")" @onclick="() => metric = key">@L["rose." + key]</button>
        }
    </div>
    <div class="rose-body">
        <svg viewBox="0 0 360 360" role="img" aria-label="@L["rose.title"]">
            @for (var ring = 0; ring < Rings; ring++)
            {
                for (var k = 0; k < 8; k++)
                {
                    var point = Data.Points[ring * 8 + k];
                    <path d="@Sector(k, R(ring), R(ring + 1))" fill="@Color(point)" class="rose-cell"><title>@Dir(k) · @Metres(point.DistanceM) · @L["metric.sun"] @Pct(point.SunlitShare) · @L["metric.darkness"] @Hours(point.LongestDarknessHours) · @L["metric.earth"] @Pct(point.EarthShare)</title></path>
                }
            }
            <circle cx="180" cy="180" r="@F(R(0))" fill="@Color(Data.Centre)" class="rose-cell"><title>@L["report.disp.centre"] · @L["metric.sun"] @Pct(Data.Centre.SunlitShare) · @L["metric.darkness"] @Hours(Data.Centre.LongestDarknessHours) · @L["metric.earth"] @Pct(Data.Centre.EarthShare)</title></circle>
            @for (var ring = 0; ring <= Rings; ring++)
            {
                <circle cx="180" cy="180" r="@F(R(ring))" class="rose-ring" />
            }
            @for (var k = 0; k < 8; k++)
            {
                var a = (k * 45 + 22.5) * Math.PI / 180;
                <line x1="@F(180 + R(0) * Math.Sin(a))" y1="@F(180 - R(0) * Math.Cos(a))" x2="@F(180 + R(Rings) * Math.Sin(a))" y2="@F(180 - R(Rings) * Math.Cos(a))" class="rose-ring" />
            }
            @for (var ring = 0; ring < Rings; ring++)
            {
                for (var k = 0; k < 8; k++)
                {
                    var point = Data.Points[ring * 8 + k];
                    var a = k * Math.PI / 4;
                    var r = (R(ring) + R(ring + 1)) / 2;
                    <g><text x="@F(180 + r * Math.Sin(a))" y="@F(184 - r * Math.Cos(a))" text-anchor="middle" class="rose-value">@Value(point)</text></g>
                }
            }
            <text x="180" y="184" text-anchor="middle" class="rose-value centre">@Value(Data.Centre)</text>
            @for (var k = 0; k < 8; k += 2)
            {
                var a = k * Math.PI / 4;
                <g><text x="@F(180 + (R(Rings) + 10) * Math.Sin(a))" y="@F(184 - (R(Rings) + 10) * Math.Cos(a))" text-anchor="middle" class="rose-dir">@Dir(k)</text></g>
            }
            @for (var ring = 1; ring <= Rings; ring++)
            {
                <g><text x="@F(180 + R(ring) * Math.Sin(Math.PI * 0.75) + 4)" y="@F(180 - R(ring) * Math.Cos(Math.PI * 0.75) + 12)" class="rose-dist">@Metres(Data.Points[(ring - 1) * 8].DistanceM)</text></g>
            }
        </svg>
        <div class="rose-side">
            <span class="cap">@L["rose.legend." + metric]</span>
            <div class="rose-scale @metric"></div>
            <div class="flegend-scale"><span>@ScaleLow</span><span>@ScaleHigh</span></div>
            <dl class="rose-ranges">
                <div><dt>@L["report.disp.centre"]</dt><dd>@Value(Data.Centre)</dd></div>
                @for (var ring = 0; ring < Rings; ring++)
                {
                    var set = Data.Points.Skip(ring * 8).Take(8).ToList();
                    var worst = set.MinBy(Better)!;
                    var best = set.MaxBy(Better)!;
                    <div><dt>@Metres(set[0].DistanceM)</dt><dd>@Value(worst) … @Value(best)</dd></div>
                }
            </dl>
            <p class="muted small">@L.Format("rose.note", Metres(Data.DemSpacingM))</p>
        </div>
    </div>
</figure>

@code {
    private static readonly string[] Metrics = ["sun", "dark", "earth"];

    [Parameter, EditorRequired]
    public ReportDispersion Data { get; set; } = default!;

    private string metric = "sun";

    private int Rings => Math.Max(1, Data.Points.Count / 8);

    private double MaxDark => Math.Max(1, Data.Points.Append(Data.Centre).Max(p => p.LongestDarknessHours));

    private static double R(int ring) => 40 + ring * 58.0;

    private double Better(ReportOffset p) => metric switch
    {
        "dark" => -p.LongestDarknessHours,
        "earth" => p.EarthShare,
        _ => p.SunlitShare,
    };

    private double Normalized(ReportOffset p) => metric switch
    {
        "dark" => 1 - p.LongestDarknessHours / MaxDark,
        "earth" => p.EarthShare,
        _ => p.SunlitShare,
    };

    private string Value(ReportOffset p) => metric switch
    {
        "dark" => Hours(p.LongestDarknessHours),
        "earth" => Pct(p.EarthShare),
        _ => Pct(p.SunlitShare),
    };

    private string ScaleLow => metric == "dark" ? Hours(MaxDark) : "0%";

    private string ScaleHigh => metric == "dark" ? "0" : "100%";

    private string Color(ReportOffset p)
    {
        var v = Math.Clamp(Normalized(p), 0, 1);
        double[][] stops = metric == "earth"
            ? [[0, 18, 26, 46], [0.5, 46, 74, 117], [1, 111, 168, 232]]
            : [[0, 28, 39, 64], [0.45, 46, 74, 117], [0.7, 181, 122, 46], [1, 245, 197, 66]];
        for (var i = 1; i < stops.Length; i++)
        {
            if (v <= stops[i][0])
            {
                var t = (v - stops[i - 1][0]) / (stops[i][0] - stops[i - 1][0]);
                var r = (int)Math.Round(stops[i - 1][1] + (stops[i][1] - stops[i - 1][1]) * t);
                var g = (int)Math.Round(stops[i - 1][2] + (stops[i][2] - stops[i - 1][2]) * t);
                var b = (int)Math.Round(stops[i - 1][3] + (stops[i][3] - stops[i - 1][3]) * t);
                return $"rgb({r},{g},{b})";
            }
        }

        return "rgb(245,197,66)";
    }

    private static string Sector(int k, double r0, double r1)
    {
        var a0 = (k * 45 - 22.5) * Math.PI / 180;
        var a1 = (k * 45 + 22.5) * Math.PI / 180;
        (double X, double Y) P(double a, double r) => (180 + r * Math.Sin(a), 180 - r * Math.Cos(a));
        var (x0, y0) = P(a0, r1);
        var (x1, y1) = P(a1, r1);
        var (x2, y2) = P(a1, r0);
        var (x3, y3) = P(a0, r0);
        return $"M{F(x0)} {F(y0)} A{F(r1)} {F(r1)} 0 0 1 {F(x1)} {F(y1)} L{F(x2)} {F(y2)} A{F(r0)} {F(r0)} 0 0 0 {F(x3)} {F(y3)} Z";
    }

    private string Dir(int k)
    {
        var names = L["explore.dirs"].Split(',');
        return names.Length == 8 ? names[k] : k.ToString(CultureInfo.InvariantCulture);
    }

    private string Metres(double m) => m >= 1000
        ? (m / 1000).ToString("0.#", CultureInfo.InvariantCulture) + " " + L["common.unit.km"]
        : m.ToString("F0", CultureInfo.InvariantCulture) + " " + L["common.unit.m"];

    private string Hours(double h) => h >= 48 ? L.Duration(TimeSpan.FromHours(h)) : h.ToString("F0", CultureInfo.InvariantCulture) + " " + L["common.unit.h"];

    private static string Pct(double f) => (f * 100).ToString("F0", CultureInfo.InvariantCulture) + "%";

    private static string F(double v) => v.ToString("F1", CultureInfo.InvariantCulture);
}
