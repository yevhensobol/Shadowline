@using System.Globalization
@using Shadowline.Core.Geometry
@using Shadowline.Core.Names
@using Shadowline.Core.Sites
@inherits LocalizedComponent
@inject IJSRuntime Js
@inject HttpClient Http

<div class="map-tabs">
    <button type="button" class="@Tab(false)" @onclick="() => SetPolar(false)">@L["map.global"]</button>
    <button type="button" class="@Tab(true)" @onclick="() => SetPolar(true)">@L["map.south"]</button>
    <button type="button" class="map-expand" @onclick="Expand" title="@L["map.expand"]" aria-label="@L["map.expand"]">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" /></svg>
    </button>
</div>

@MapSvg(false)
<p class="map-readout" aria-live="polite">@Readout()</p>
<p class="muted map-credit">@(L[polar ? "map.credit.south" : "map.credit"])</p>

<dialog @ref="dialog" class="map-dialog" aria-label="@L["map.title"]">
    @if (expanded)
    {
        <div class="map-dialog-body">
            <div class="map-dialog-bar">
                <div class="map-tabs">
                    <button type="button" class="@Tab(false)" @onclick="() => SetPolar(false)">@L["map.global"]</button>
                    <button type="button" class="@Tab(true)" @onclick="() => SetPolar(true)">@L["map.south"]</button>
                </div>
                <span class="muted map-hint">@L["map.hint"]</span>
                <div class="map-zoom">
                    <button type="button" @onclick="() => ZoomBy(1.6)" title="@L["map.zoomIn"]" aria-label="@L["map.zoomIn"]">+</button>
                    <button type="button" @onclick="() => ZoomBy(1 / 1.6)" title="@L["map.zoomOut"]" aria-label="@L["map.zoomOut"]">&minus;</button>
                    <button type="button" @onclick="ResetView" title="@L["map.reset"]" aria-label="@L["map.reset"]">1:1</button>
                    <button type="button" class="map-close" @onclick="Collapse" title="@L["map.close"]" aria-label="@L["map.close"]">&times;</button>
                </div>
            </div>
            @MapSvg(true)
            <p class="map-readout" aria-live="polite">@Readout()</p>
            <p class="muted map-credit">@(L[polar ? "map.credit.south" : "map.credit"])</p>
        </div>
    }
</dialog>

@code {
    private const double FlatWidth = 1024;
    private const double FlatHeight = 512;
    private const double PolarSize = 400;
    private static readonly int[] PolarParallels = [-70, -80];

    private readonly EquirectangularProjection Flat = new(FlatWidth, FlatHeight);
    private readonly SouthPolarProjection PolarProjection = new(PolarSize, -60);

    private double MaxZoom => polar ? 8 : 48;

    private const double ScreenPixels = 1000;
    private const int MaxTiles = 64;
    private const double TileOverlap = 1 + 0.75 / 256;
    private const string SouthTiles = "https://trek.nasa.gov/tiles/Moon/SP/LRO_WAC_Mosaic_SPole60_100m_v02/1.0.0/default/default028mm/{0}/{1}/{2}.png";
    private const string GlobalTiles = "https://trek.nasa.gov/tiles/Moon/EQ/LRO_WAC_Mosaic_Global_303ppd_v02/1.0.0/default/default028mm/{0}/{1}/{2}.jpg";
    private const double SouthOriginM = 1095930;
    private const double SouthLevel0PixelM = 2 * SouthOriginM / 256;
    private const int SouthMaxLevel = 5;
    private const int GlobalMaxLevel = 7;
    private const double SouthBaseM = 909;
    private const double GlobalBaseDeg = 360.0 / 2048;

    private readonly record struct MapTile(string Href, double X, double Y, double Size);

    private IEnumerable<MapTile> Tiles()
    {
        var vx = ViewX(true);
        var vy = ViewY(true);
        var vw = ViewWidth(true);
        var vh = ViewHeight(true);
        if (polar)
        {
            var halfM = 2 * Shadowline.Core.Terrain.LocalTerrain.MoonRadiusM * Math.Tan((90.0 + PolarProjection.LimitLatitudeDeg) * Math.PI / 360.0);
            var unitsPerM = PolarSize / halfM;
            var wantM = vw / unitsPerM / ScreenPixels;
            if (wantM >= SouthBaseM * 0.8)
            {
                yield break;
            }

            var level = Math.Clamp((int)Math.Floor(Math.Log2(SouthLevel0PixelM / wantM) + 0.5), 0, SouthMaxLevel);
            var tileM = 2 * SouthOriginM / Math.Pow(2, level);
            var xMin = (vx - PolarSize) / unitsPerM;
            var xMax = (vx + vw - PolarSize) / unitsPerM;
            var yTop = (PolarSize - vy) / unitsPerM;
            var yBottom = (PolarSize - vy - vh) / unitsPerM;
            var c0 = (int)Math.Floor((xMin + SouthOriginM) / tileM);
            var c1 = (int)Math.Floor((xMax + SouthOriginM) / tileM);
            var r0 = (int)Math.Floor((SouthOriginM - yTop) / tileM);
            var r1 = (int)Math.Floor((SouthOriginM - yBottom) / tileM);
            var count = 0;
            for (var row = Math.Max(0, r0); row <= r1 && row < (1 << level); row++)
            {
                for (var col = Math.Max(0, c0); col <= c1 && col < (1 << level); col++)
                {
                    if (++count > MaxTiles)
                    {
                        yield break;
                    }

                    var x = PolarSize + (-SouthOriginM + col * tileM) * unitsPerM;
                    var y = PolarSize - (SouthOriginM - row * tileM) * unitsPerM;
                    yield return new MapTile(string.Format(CultureInfo.InvariantCulture, SouthTiles, level, row, col), x, y, tileM * unitsPerM);
                }
            }
        }
        else
        {
            var unitsPerDeg = FlatWidth / 360.0;
            var wantDeg = vw / unitsPerDeg / ScreenPixels;
            if (wantDeg >= GlobalBaseDeg * 0.8)
            {
                yield break;
            }

            var level = Math.Clamp((int)Math.Floor(Math.Log2(180.0 / 256 / wantDeg) + 0.5), 0, GlobalMaxLevel);
            var tileDeg = 180.0 / Math.Pow(2, level);
            var c0 = (int)Math.Floor(vx / unitsPerDeg / tileDeg);
            var c1 = (int)Math.Floor((vx + vw) / unitsPerDeg / tileDeg);
            var r0 = (int)Math.Floor(vy / unitsPerDeg / tileDeg);
            var r1 = (int)Math.Floor((vy + vh) / unitsPerDeg / tileDeg);
            var count = 0;
            for (var row = Math.Max(0, r0); row <= r1 && row < (1 << level); row++)
            {
                for (var col = Math.Max(0, c0); col <= c1 && col < (2 << level); col++)
                {
                    if (++count > MaxTiles)
                    {
                        yield break;
                    }

                    yield return new MapTile(string.Format(CultureInfo.InvariantCulture, GlobalTiles, level, row, col), col * tileDeg * unitsPerDeg, row * tileDeg * unitsPerDeg, tileDeg * unitsPerDeg);
                }
            }
        }
    }

    private readonly string smallId = "moon-map-" + Guid.NewGuid().ToString("N");
    private string BigId => smallId + "-big";

    private ElementReference dialog;
    private DotNetObjectReference<MoonMap>? self;
    private bool polar;
    private bool expanded;
    private bool openPending;
    private SubPoint? hover;
    private Site? hoverSite;
    private string? hoverBody;
    private LunarNames? names;
    private static Task<LunarNames?>? namesTask;
    private double zoom = 1;
    private double centerX = FlatWidth / 2;
    private double centerY = FlatHeight / 2;

    [Parameter, EditorRequired]
    public IReadOnlyList<Site> Sites { get; set; } = [];

    [Parameter]
    public string? SelectedId { get; set; }

    [Parameter]
    public SubPoint? Selected { get; set; }

    [Parameter]
    public SubPoint? Sun { get; set; }

    [Parameter]
    public SubPoint? Earth { get; set; }

    [Parameter]
    public EventCallback<string> SiteSelected { get; set; }

    [Parameter]
    public EventCallback<SubPoint> PointSelected { get; set; }

    private double Width => polar ? PolarSize * 2 : FlatWidth;

    private double Height => polar ? PolarSize * 2 : FlatHeight;

    private double ViewWidth(bool big) => Width / (big ? zoom : 1);

    private double ViewHeight(bool big) => Height / (big ? zoom : 1);

    private double ViewX(bool big) => big ? Math.Clamp(centerX - ViewWidth(true) / 2, 0, Width - ViewWidth(true)) : 0;

    private double ViewY(bool big) => big ? Math.Clamp(centerY - ViewHeight(true) / 2, 0, Height - ViewHeight(true)) : 0;

    private string ViewBox(bool big) => $"{Format(ViewX(big))} {Format(ViewY(big))} {Format(ViewWidth(big))} {Format(ViewHeight(big))}";

    private string Ratio => (Width / Height).ToString("0.###", CultureInfo.InvariantCulture);

    private double Marker(bool big) => (polar ? 7 : 5) / (big ? zoom : 1);

    private string Tab(bool forPolar) => polar == forPolar ? "active" : string.Empty;

    private static string Format(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private bool Visible(SubPoint point) => !polar || PolarProjection.Contains(point.LatitudeDeg);

    private MapPoint Place(SubPoint point) => polar
        ? PolarProjection.Project(point.LatitudeDeg, point.LongitudeEastDeg)
        : Flat.Project(point.LatitudeDeg, point.LongitudeEastDeg);

    private IEnumerable<string> TerminatorPaths()
    {
        if (Sun is not { } sun)
        {
            yield break;
        }

        var points = sun.Terminator(180);
        var builder = new System.Text.StringBuilder();
        MapPoint? previous = null;
        SubPoint? previousGeo = null;
        foreach (var geo in points.OrderBy(point => polar ? 0 : EquirectangularProjection.NormalizeLongitude(point.LongitudeEastDeg)))
        {
            if (!Visible(geo))
            {
                if (builder.Length > 0)
                {
                    yield return builder.ToString();
                    builder.Clear();
                }

                previous = null;
                continue;
            }

            var place = Place(geo);
            var jump = previous is { } last && previousGeo is { } lastGeo
                && !polar && Math.Abs(EquirectangularProjection.NormalizeLongitude(geo.LongitudeEastDeg) - EquirectangularProjection.NormalizeLongitude(lastGeo.LongitudeEastDeg)) > 90;
            builder.Append(builder.Length == 0 || jump ? "M" : "L")
                .Append(Format(place.X)).Append(' ').Append(Format(place.Y)).Append(' ');
            previous = place;
            previousGeo = geo;
        }

        if (builder.Length > 0)
        {
            yield return builder.ToString();
        }
    }

    private async Task SelectSite(string id) => await SiteSelected.InvokeAsync(id);

    private async Task OnMapClick(bool big, MouseEventArgs args)
    {
        var fractions = await Js.InvokeAsync<double[]>("shadowlineMap.fractions", big ? BigId : smallId, args.ClientX, args.ClientY);
        if (fractions.Length != 2)
        {
            return;
        }

        var x = ViewX(big) + fractions[0] * ViewWidth(big);
        var y = ViewY(big) + fractions[1] * ViewHeight(big);
        var point = polar ? PolarProjection.Unproject(x, y) : Flat.Unproject(x, y);
        if (point.LatitudeDeg is < -90 or > 90 || (polar && !PolarProjection.Contains(point.LatitudeDeg)))
        {
            return;
        }

        await PointSelected.InvokeAsync(point);
    }

    private void SetPolar(bool value)
    {
        polar = value;
        ResetView();
    }

    private void ResetView()
    {
        zoom = 1;
        centerX = Width / 2;
        centerY = Height / 2;
    }

    private void ZoomBy(double factor) => ZoomAt(0.5, 0.5, factor);

    private void ZoomAt(double fx, double fy, double factor)
    {
        var anchorX = ViewX(true) + fx * ViewWidth(true);
        var anchorY = ViewY(true) + fy * ViewHeight(true);
        zoom = Math.Clamp(zoom * factor, 1, MaxZoom);
        centerX = anchorX - fx * ViewWidth(true) + ViewWidth(true) / 2;
        centerY = anchorY - fy * ViewHeight(true) + ViewHeight(true) / 2;
        ClampCenter();
    }

    private void ClampCenter()
    {
        centerX = Math.Clamp(centerX, ViewWidth(true) / 2, Width - ViewWidth(true) / 2);
        centerY = Math.Clamp(centerY, ViewHeight(true) / 2, Height - ViewHeight(true) / 2);
    }

    private void Expand()
    {
        ResetView();
        expanded = true;
        openPending = true;
    }

    private async Task Collapse() => await Js.InvokeVoidAsync("shadowlineMap.close", dialog);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            self ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("shadowlineMap.watch", smallId, self, false);
            _ = LoadNamesAsync();
        }

        if (openPending)
        {
            openPending = false;
            self ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("shadowlineMap.open", dialog, BigId, self);
        }
    }

    private async Task LoadNamesAsync()
    {
        namesTask ??= LoadNames(Http);
        names = await namesTask;
        if (names is not null)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private static async Task<LunarNames?> LoadNames(HttpClient http)
    {
        try
        {
            var bytes = await http.GetByteArrayAsync("data/names.json");
            return LunarNames.Parse(new MemoryStream(bytes));
        }
        catch (HttpRequestException)
        {
            return null;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    [JSInvokable]
    public void OnHover(double fx, double fy, bool big)
    {
        var x = ViewX(big) + fx * ViewWidth(big);
        var y = ViewY(big) + fy * ViewHeight(big);
        var point = polar ? PolarProjection.Unproject(x, y) : Flat.Unproject(x, y);
        if (point.LatitudeDeg is < -90 or > 90 || (polar && !PolarProjection.Contains(point.LatitudeDeg)))
        {
            hover = null;
            hoverSite = null;
            hoverBody = null;
        }
        else
        {
            hover = point;
            var reach = Marker(big) * 1.5;
            hoverSite = Sites
                .Where(site => Visible(new SubPoint(site.LatitudeDeg, site.LongitudeEastDeg)))
                .Select(site => (site, place: Place(new SubPoint(site.LatitudeDeg, site.LongitudeEastDeg))))
                .Where(item => Math.Abs(item.place.X - x) <= reach && Math.Abs(item.place.Y - y) <= reach)
                .OrderBy(item => Math.Pow(item.place.X - x, 2) + Math.Pow(item.place.Y - y, 2))
                .Select(item => item.site)
                .FirstOrDefault();
            hoverBody = Near(Sun, x, y, reach * 1.4) ? "map.subsolar" : Near(Earth, x, y, reach * 1.4) ? "map.subearth" : null;
        }

        StateHasChanged();
    }

    private bool Near(SubPoint? body, double x, double y, double reach)
    {
        if (body is not { } point || !Visible(point))
        {
            return false;
        }

        var place = Place(point);
        return Math.Abs(place.X - x) <= reach && Math.Abs(place.Y - y) <= reach;
    }

    [JSInvokable]
    public void OnHoverEnd()
    {
        hover = null;
        hoverSite = null;
        hoverBody = null;
        StateHasChanged();
    }

    private string Readout()
    {
        if ((hover ?? Selected) is not { } point)
        {
            return string.Empty;
        }

        var longitude = EquirectangularProjection.NormalizeLongitude(point.LongitudeEastDeg);
        var parts = new List<string> { L.Lat(point.LatitudeDeg, 2) + ", " + L.Lon(longitude, 2) };
        var site = hover is null ? Sites.FirstOrDefault(item => item.Id == SelectedId) : hoverSite;
        if (site is not null)
        {
            parts.Add(L.Name(site));
        }

        if (hover is not null && hoverBody is not null)
        {
            parts.Add(L[hoverBody]);
        }

        if (names?.Containing(point.LatitudeDeg, longitude) is { } feature)
        {
            var digits = feature.DiameterKm < 10 ? 1 : 0;
            parts.Add(feature.Name + ", Ø " + Localizer.Number(feature.DiameterKm, digits) + " " + L["common.unit.km"]);
        }

        return string.Join(" · ", parts);
    }

    [JSInvokable]
    public void OnDialogClosed()
    {
        expanded = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnWheel(double fx, double fy, double deltaY)
    {
        ZoomAt(fx, fy, Math.Exp(-Math.Clamp(deltaY, -400, 400) * 0.0018));
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPan(double dfx, double dfy)
    {
        centerX -= dfx * ViewWidth(true);
        centerY -= dfy * ViewHeight(true);
        ClampCenter();
        StateHasChanged();
    }

    public override void Dispose()
    {
        self?.Dispose();
        base.Dispose();
    }

    private RenderFragment MapSvg(bool big) => @<svg id="@(big ? BigId : smallId)" class="@(big ? "moon-map big" : "moon-map")" style="--map-ratio: @Ratio" viewBox="@ViewBox(big)" role="img" aria-label="@L["map.title"]" @onclick="args => OnMapClick(big, args)">
        @if (big)
        {
            <defs>
                <filter id="@(BigId)-sp" color-interpolation-filters="sRGB"><feComponentTransfer><feFuncR type="gamma" exponent="0.833" /><feFuncG type="gamma" exponent="0.833" /><feFuncB type="gamma" exponent="0.833" /></feComponentTransfer></filter>
                <filter id="@(BigId)-eq" color-interpolation-filters="sRGB"><feComponentTransfer><feFuncR type="linear" slope="1.244" /><feFuncG type="linear" slope="1.244" /><feFuncB type="linear" slope="1.244" /></feComponentTransfer><feComponentTransfer><feFuncR type="gamma" exponent="0.833" /><feFuncG type="gamma" exponent="0.833" /><feFuncB type="gamma" exponent="0.833" /></feComponentTransfer></filter>
            </defs>
        }
        <rect x="0" y="0" width="@Format(Width)" height="@Format(Height)" class="map-bg" />
        @if (polar)
        {
            <image href="img/moon/south.jpg" x="0" y="0" width="@Format(Width)" height="@Format(Height)" preserveAspectRatio="none" />
            @if (big)
            {
                <g class="map-tiles" filter="url(#@(BigId)-sp)">
                    @foreach (var tile in Tiles())
                    {
                        <image @key="tile.Href" href="@tile.Href" x="@Format(tile.X)" y="@Format(tile.Y)" width="@Format(tile.Size * TileOverlap)" height="@Format(tile.Size * TileOverlap)" preserveAspectRatio="none" />
                    }
                </g>
            }
            @foreach (var latitude in PolarParallels)
            {
                var ring = PolarProjection.Project(latitude, 0);
                <circle cx="@Format(PolarSize)" cy="@Format(PolarSize)" r="@Format(PolarSize - ring.Y)" class="map-grid" />
            }
        }
        else
        {
            <image href="img/moon/equirect.jpg" x="0" y="0" width="@Format(Width)" height="@Format(Height)" preserveAspectRatio="none" />
            @if (big)
            {
                <g class="map-tiles" filter="url(#@(BigId)-eq)">
                    @foreach (var tile in Tiles())
                    {
                        <image @key="tile.Href" href="@tile.Href" x="@Format(tile.X)" y="@Format(tile.Y)" width="@Format(tile.Size * TileOverlap)" height="@Format(tile.Size * TileOverlap)" preserveAspectRatio="none" />
                    }
                </g>
            }
            @for (var latitude = -60; latitude <= 60; latitude += 30)
            {
                var y = Flat.Project(latitude, 0).Y;
                <line x1="0" x2="@Format(Width)" y1="@Format(y)" y2="@Format(y)" class="map-grid" />
            }

            @for (var longitude = -150; longitude <= 150; longitude += 30)
            {
                var x = Flat.Project(0, longitude).X;
                <line x1="@Format(x)" x2="@Format(x)" y1="0" y2="@Format(Height)" class="map-grid" />
            }
        }

        @foreach (var path in TerminatorPaths())
        {
            <path d="@path" class="map-terminator" />
        }

        @if (Sun is { } sun && Visible(sun))
        {
            var point = Place(sun);
            <circle cx="@Format(point.X)" cy="@Format(point.Y)" r="@Format(Marker(big) * 1.4)" class="sun"><title>@L["map.subsolar"]</title></circle>
        }

        @if (Earth is { } earth && Visible(earth))
        {
            var point = Place(earth);
            <circle cx="@Format(point.X)" cy="@Format(point.Y)" r="@Format(Marker(big) * 1.4)" class="earth"><title>@L["map.subearth"]</title></circle>
        }

        @foreach (var site in Sites)
        {
            @if (Visible(new SubPoint(site.LatitudeDeg, site.LongitudeEastDeg)))
            {
                var point = Place(new SubPoint(site.LatitudeDeg, site.LongitudeEastDeg));
                var id = site.Id;
                <g class="@(id == SelectedId ? "map-site selected" : "map-site")" @onclick="() => SelectSite(id)" @onclick:stopPropagation="true">
                    <circle cx="@Format(point.X)" cy="@Format(point.Y)" r="@Format(Marker(big))" />
                    <title>@L.Name(site)</title>
                </g>
            }
        }

        @if (Selected is { } chosen && Visible(chosen) && Sites.All(site => site.Id != SelectedId))
        {
            var point = Place(chosen);
            <circle cx="@Format(point.X)" cy="@Format(point.Y)" r="@Format(Marker(big))" class="map-custom" />
        }
    </svg>;
}
