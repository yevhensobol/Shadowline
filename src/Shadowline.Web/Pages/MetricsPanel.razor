@inherits LocalizedComponent
@using Shadowline.Core.Metrics

<dl class="metrics">
    <div><dt>@L["metric.sun"]</dt><dd>@Percent(Metrics.SunFraction)</dd></div>
    <div><dt>@L["metric.darkness"]</dt><dd>@L.Duration(Metrics.LongestDarkness)</dd></div>
    <div><dt>@L["metric.earth"]</dt><dd>@Percent(Metrics.EarthFraction)</dd></div>
    @if (!Compact)
    {
        <div><dt>@L["metric.gap"]</dt><dd>@L.Duration(Metrics.LongestEarthGap)</dd></div>
        <div><dt>@L["metric.eclipse"]</dt><dd>@L.Duration(Metrics.EarthOverSun)</dd></div>
    }
</dl>

@code {
    [Parameter, EditorRequired]
    public WindowMetrics Metrics { get; set; } = default!;

    [Parameter]
    public bool Compact { get; set; }

    private static string Percent(double fraction) => (fraction * 100).ToString("F0") + "%";
}
