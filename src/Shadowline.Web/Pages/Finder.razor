    public string? Date { get; set; }

    private LanderSpec Lander => new(Math.Max(0, panelW), Math.Max(0, loadW), Math.Max(0, batteryKWh) * 1000);

    protected override async Task OnInitializedAsync()
    {
        await Store.LoadAsync();
        await Missions.EnsureLoadedAsync();
        var mission = Missions.Current;
        if (ProfileKeys.FirstOrDefault(key => Matches(key, mission)) is { } matched)
        {
            ApplyProfile(matched);
        }
        else
        {
            ApplyProfile("water");
            profileKey = FinderPreset.Custom;
            (panelW, loadW, batteryKWh, durationDays, minEarth) = (mission.PanelW, mission.LoadW, mission.BatteryWh / 1000, mission.DurationDays, mission.MinEarthShare);
        }
        grid = await FinderData.LoadAsync();
        failed = grid is null;
        targetSiteId = PolarSites().FirstOrDefault()?.Id;
        if (DateTime.TryParseExact(Date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var asked))
        {
            landingDate = asked;
        }

        if (grid is not null && (landingDate < grid.StartUtc.UtcDateTime || landingDate >= grid.EndUtc.UtcDateTime))
        {
            landingDate = grid.StartUtc.UtcDateTime.Date.AddDays(120);
        }

        if (grid is not null)
        {
            await RunAsync();
        }
    }

    private IEnumerable<Site> PolarSites() =>
        Store.Catalog?.Sites.Where(site => site.LatitudeDeg <= (grid?.DomainLatitudeDeg ?? -84) + 0.3 && !site.Id.StartsWith("syn-", StringComparison.Ordinal)) ?? [];

    private static bool Matches(string key, Shadowline.Core.Missions.Mission mission) => FinderPreset.Get(key).Fits(mission);

    private void ApplyProfile(string key)
    {
        var preset = FinderPreset.Get(key);
        profileKey = preset.Key;
        (wSun, wEarth, wWater, wSlope, wTarget) = (preset.Weights.Sun, preset.Weights.Earth, preset.Weights.Water, preset.Weights.Slope, preset.Weights.Target);
        (durationDays, batteryKWh, minEarth) = (preset.DurationDays, preset.BatteryWh / 1000, preset.MinEarthShare);
        targetKey = preset.Target == TargetKind.ColdTrap ? "water" : "none";
        panelW = preset.PanelW;
        loadW = preset.LoadW;
        maxSlope = FinderPreset.MaxSlopeDeg;
        rangeKm = FinderPreset.RangeKm;
        flexDays = FinderPreset.FlexDays;
    }

    private void SetTarget(string key)
    {
        targetKey = key;
        if (key == "site" && wTarget <= 0)
        {
            wTarget = 60;
        }
        else if (key != "site")
        {
            wTarget = 0;
        }
    }

    private MissionProfile BuildProfile()
    {
        Site? site = targetKey == "site" && targetSiteId is not null ? Store.Catalog?.Find(targetSiteId) : null;
        var kind = targetKey switch
        {
            "water" => TargetKind.ColdTrap,
            "site" when site is not null => TargetKind.Point,
            _ => TargetKind.None,
        };
        return new MissionProfile(
            new DateTimeOffset(DateTime.SpecifyKind(landingDate.Date.AddHours(12), DateTimeKind.Utc)),
            flexDays,
            Math.Clamp(durationDays, 1, 60),
            Lander,
            maxSlope,
            minEarth,
            kind,
            site?.LatitudeDeg,
            site?.LongitudeEastDeg,
            Math.Clamp(rangeKm, 0.5, 50),
            new CriteriaWeights(wSun, wEarth, wWater, wSlope, wTarget).Clamp());
    }

    private async Task QuickProfile(string key)
    {
        ApplyProfile(key);
        pins.Clear();
        selCell = -1;
        selZone = null;
        await RunAsync();
    }

    private async Task RunAsync()
    {
        if (grid is null)
        {
            return;
        }

        computing = true;
        StateHasChanged();
        var next = Missions.Current with { PanelW = panelW, LoadW = loadW, BatteryWh = batteryKWh * 1000, DurationDays = durationDays, MinEarthShare = minEarth };
        if (FinderPreset.All.FirstOrDefault(preset => preset.Key == profileKey) is { } chosen && chosen.Fits(next))
        {
            next = chosen.Apply(next);
        }

        await Missions.SetAsync(next);
        await Task.Delay(30);
        var profile = BuildProfile();
        result = SiteFinder.Evaluate(grid, profile, minZoneCells);
        await Task.Yield();
        slopeCounts = SiteFinder.SlopeCounts(grid, result);
        earthCounts = SiteFinder.EarthCounts(grid, result);
        stability = SiteFinder.Stability(result);
        pins.RemoveAll(pin => !grid.InDomain(pin.Cell));
        if (pins.Count == 0)
        {
            foreach (var zone in result.Zones.Take(MaxPins))
            {
                pins.Add(new Pin(zone.BestCell, "Z" + zone.Rank));
            }
        }
        if (selZone is null && selCell < 0 && result.Zones.Count > 0)
        {
            Select(result.Zones[0].BestCell);
        }
        else if (selCell >= 0)
        {
            Select(selCell);
        }

        computing = false;
        step = 2;
        redraw = true;
    }

    private async Task SetSlope(double value)
    {
        maxSlope = value;
        await RunAsync();
    }

    private async Task SetEarth(double value)
    {
        minEarth = value;
        await RunAsync();
    }

    private async Task SetArea(int cells)
    {
        minZoneCells = cells;
        await RunAsync();
    }

    private void SetLayer(string key)
    {
        layer = key;
        redraw = true;
    }

    private void GoStep(int target)
    {
        if (target == 2 && result is null || target == 3 && pins.Count == 0)
        {
            return;
        }

        if (step == 2 && target != 2)
        {
            DetachMap();
        }

        step = target;
        redraw = target == 2;
    }

    private void Select(int cell)
    {
        selCell = cell;
        selZone = result is not null && result.ZoneOf[cell] >= 0 ? result.ZoneOf[cell] : null;
        if (selZone is { } z && result is not null)
        {
            selCell = result.Zones[z].BestCell;
        }
    }

    [JSInvokable]
    public void OnCellClick(int cell)
    {
        if (grid is null || result is null || cell < 0 || cell >= grid.Count || !grid.InDomain(cell))
        {
            return;
        }

        Select(cell);
        redraw = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCellHover(int cell)
    {
        hoverCell = cell;
        StateHasChanged();
    }

    private void PinSelected()
    {
        if (selCell < 0 || pins.Count >= MaxPins || pins.Any(pin => pin.Cell == selCell))
        {
            return;
        }

        var label = selZone is { } z ? "Z" + (z + 1) : L["finder.point"] + " " + L.Lat(grid!.LatLon(selCell).LatitudeDeg, 1);
        pins.Add(new Pin(selCell, label));
    }

    private void Unpin(int cell) => pins.RemoveAll(pin => pin.Cell == cell);

    private void AddReference(ChangeEventArgs args)
    {
        if (grid is null || args.Value?.ToString() is not { Length: > 0 } id || Store.Catalog?.Find(id) is not { } site || pins.Count >= MaxPins)
        {
            return;
        }

        if (grid.CellAt(site.LatitudeDeg, site.LongitudeEastDeg) is { } cell && grid.InDomain(cell) && pins.All(pin => pin.Cell != cell))
        {
            pins.Add(new Pin(cell, L.Name(site)));
        }
    }

    private CellInfo Info(int cell)
    {
        var (lat, lon) = grid!.LatLon(cell);
        return new CellInfo(lat, lon, result!.Windows[cell], result.Utilities[cell]);
    }

    private double MissAt(int cell, double km) =>
        SiteFinder.MissCurve(grid!, result!, cell, km).LastOrDefault()?.PassShare ?? 0;

    private string FailText(FinderFail fail) =>
        string.Join(", ", Enum.GetValues<FinderFail>().Where(flag => flag != FinderFail.None && fail.HasFlag(flag)).Select(flag => L["finder.fail." + flag]));

    private string? Bad(int cell, FinderFail flag) => result is not null && result.Fail[cell].HasFlag(flag) ? "bad" : null;

    private string Summary() =>
        L.Format("finder.summary", L["finder.profile." + profileKey], L.ShortDate(new DateTimeOffset(DateTime.SpecifyKind(landingDate, DateTimeKind.Utc))), flexDays switch { 0 => string.Empty, > 60 => "· " + L["finder.flexYear"], _ => "±" + flexDays }, durationDays);

    private string HoverText()
    {
        if (grid is null || result is null || hoverCell < 0 || !grid.InDomain(hoverCell))
        {
            return " ";
        }

        var (lat, lon) = grid.LatLon(hoverCell);
        var w = result.Windows[hoverCell];
        var head = L.Lat(lat, 2) + " · " + L.Lon(lon, 1) + " · ";
        var fail = result.Fail[hoverCell];
        return head + (fail == FinderFail.None ? F2(result.Score[hoverCell]) : L["finder.fails"] + ": " + FailText(fail))
            + " · " + L.Format("explore.cardSun", Pct(w.SunShare)) + " · " + L.Format("explore.cardEarth", Pct(w.EarthShare));
    }

    private IEnumerable<FinderZone> LabelZones()
    {
        var placed = new List<(double X, double Y)>();
        foreach (var zone in result!.Zones)
        {
            var p = CellPercent(zone.BestCell);
            var near = placed.Any(q => Math.Abs(q.X - p.X) < 4.5 && Math.Abs(q.Y - p.Y) < 3.5);
            if ((near && selZone != zone.Rank - 1) || (placed.Count >= 10 && selZone != zone.Rank - 1))
            {
                continue;
            }

            placed.Add(p);
            yield return zone;
        }
    }

    private (double X, double Y) CellPercent(int cell)
    {
        var row = cell / grid!.Size;
        var col = cell % grid.Size;
        return ((col + 0.5) / grid.Size * 100, (row + 0.5) / grid.Size * 100);
    }

    private (string Id, int Start) PinSite(int cell)
    {
        var (lat, lon) = grid!.LatLon(cell);
        var id = CustomSite.Create(lat, lon).Id;
        var t = Store.Manifest is null ? 0 : Math.Clamp(Store.Manifest.Grid.IndexOf(grid.At(result!.Windows[cell].StartStep)), 0, Store.Manifest.Grid.Count - 1);
        return (id, t);
    }

    private string ExploreLink(int cell)
    {
        var (id, t) = PinSite(cell);
        return $"?site={Uri.EscapeDataString(id)}&t={t}";
    }

    private string ReportLink(int cell)
    {
        var (id, t) = PinSite(cell);
        return $"report?site={Uri.EscapeDataString(id)}&t={t}&w={durationDays * 24}";
    }

    private IReadOnlyList<FinderChart.Line> DateSeries()
    {
        var output = new List<FinderChart.Line>();
        for (var i = 0; i < pins.Count; i++)
        {
            var curve = SiteFinder.DateCurve(grid!, result!, pins[i].Cell);
            var points = curve.Select(p => ((p.Start - grid!.StartUtc).TotalDays, p.Score)).ToList();
            var dots = curve.Where(p => p.Pass).Select(p => ((p.Start - grid!.StartUtc).TotalDays, p.Score)).ToList();
            output.Add(new FinderChart.Line(pins[i].Label, Css[i % Css.Length], points, dots));
        }

        return output;
    }

    private IReadOnlyList<FinderChart.Line> MissSeries() =>
        pins.Select((pin, i) => new FinderChart.Line(pin.Label, Css[i % Css.Length],
            SiteFinder.MissCurve(grid!, result!, pin.Cell).Select(p => (p.RadiusKm, p.PassShare)).ToList())).ToList();

    private (double, double)? WindowBand()
    {
        var (first, last, length) = SiteFinder.StartRange(grid!, result!.Profile);
        return ((grid!.At(first) - grid.StartUtc).TotalDays, (grid.At(last + length) - grid.StartUtc).TotalDays);
    }

    private IReadOnlyList<FinderChart.Tick> MonthTicks()
    {
        var ticks = new List<FinderChart.Tick>();
        var start = grid!.StartUtc;
        var month = new DateTimeOffset(start.Year, start.Month, 1, 0, 0, 0, TimeSpan.Zero);
        var names = L.Language == "uk" ? new[] { "січ", "лют", "бер", "кві", "тра", "чер", "лип", "сер", "вер", "жов", "лис", "гру" } : new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        for (var i = 0; i < 13; i += 2)
        {
            var m = month.AddMonths(i);
            if (m >= start && m <= grid.EndUtc)
            {
                ticks.Add(new FinderChart.Tick((m - start).TotalDays, names[m.Month - 1]));
            }
        }

        return ticks;
    }

    private RenderFragment WeightRow(string key, double value, Action<double> set) =>
        @<div class="wslider">
            <span class="wlabel">@L[key]</span>
            <input type="range" min="0" max="100" step="1" value="@value.ToString("F0", CultureInfo.InvariantCulture)" aria-label="@L[key]" @oninput="args => set(Parse(args, value))" style="--fill: @F(value)%" />
            <input type="number" min="0" max="100" step="1" value="@value.ToString("F0", CultureInfo.InvariantCulture)" aria-label="@L[key]" @onchange="args => set(Parse(args, value))" />
        </div>;

    private static double Parse(ChangeEventArgs args, double fallback) =>
        double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? Math.Clamp(v, 0, 100) : fallback;

    private string Hours(double hours) =>
        double.IsPositiveInfinity(hours) ? "∞" : hours >= 48 ? L.Duration(TimeSpan.FromHours(hours)) : hours.ToString("F0", CultureInfo.InvariantCulture) + " " + L["common.unit.h"];

    private static string Pct(double fraction) => (fraction * 100).ToString("F0", CultureInfo.InvariantCulture) + "%";

    private static string F2(double value) => value.ToString("F2", CultureInfo.InvariantCulture);

    private static string F(double value) => value.ToString("F1", CultureInfo.InvariantCulture);

    private (byte[] Values, byte[] States, byte[] Zones) Planes()
    {
        var g = grid!;
        var r = result!;
        var values = new byte[g.Count];
        var states = new byte[g.Count];
        var zones = new byte[g.Count];
        for (var cell = 0; cell < g.Count; cell++)
        {
            zones[cell] = r.ZoneOf[cell] is >= 0 and < 254 ? (byte)r.ZoneOf[cell] : (byte)255;
            if (!g.InDomain(cell))
            {
                continue;
            }

            var pass = r.Fail[cell] == FinderFail.None;
            double v;
            switch (layer)
            {
                case "sun":
                    v = r.Windows[cell].SunShare;
                    states[cell] = 2;
                    break;
                case "earth":
                    v = r.Windows[cell].EarthShare;
                    states[cell] = 2;
                    break;
                case "slope":
                    v = 1 - Math.Min(1, g.SlopeHighDeg(cell) / 20.0);
                    states[cell] = 2;
                    break;
                case "water":
                    v = 1 - Math.Min(1, g.WaterDistanceKm(cell) / 10.0);
                    states[cell] = 2;
                    break;
                default:
                    v = r.Score[cell];
                    states[cell] = pass ? (byte)2 : (byte)1;
                    break;
            }

            values[cell] = (byte)Math.Clamp(Math.Round(v * 255), 0, 255);
        }

        return (values, states, zones);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!redraw || step != 2 || result is null || grid is null)
        {
            return;
        }

        redraw = false;
        try
        {
            module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/finder.js");
            self ??= DotNetObjectReference.Create(this);
            attached ??= await module.InvokeAsync<IJSObjectReference>("attach", hit, self, grid.Size);
            var (values, states, zones) = Planes();
            await module.InvokeVoidAsync("draw", heat, lines, grid.Size, values, states, zones, selZone ?? -1, selCell);
        }
        catch (JSException)
        {
        }
    }

    private void DetachMap()
    {
        if (attached is not null)
        {
            _ = attached.InvokeVoidAsync("dispose").AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
            attached = null;
        }
    }

    private async Task PrintAsync()
    {
        try
        {
            var files = await Js.InvokeAsync<IJSObjectReference>("import", "./js/files.js");
            await files.InvokeVoidAsync("print");
        }
        catch (JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (attached is not null)
            {
                await attached.InvokeVoidAsync("dispose");
            }

            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        self?.Dispose();
    }
