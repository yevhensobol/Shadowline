@page "/finder"
@page "/plan"
@page "/plan/where"
@using System.Globalization
@using Microsoft.JSInterop
@using Shadowline.Core.Finder
@using Shadowline.Core.Sites
@using Shadowline.Web.Components
@inherits LocalizedComponent
@implements IAsyncDisposable
@inject FinderStore FinderData
@inject DataStore Store
@inject IJSRuntime Js
@inject MissionStore Missions

<PageTitle>@L["finder.title"] - Shadowline</PageTitle>

<Shadowline.Web.Components.PlanTabs Tab="where" />

<div class="finder">
    <div class="finder-ribbon">
        <span>@L.Format("finder.stepOf", step)</span>
        <b>@L["finder.step" + step]</b>
    </div>
    <nav class="finder-steps" aria-label="@L["finder.title"]">
        <button type="button" aria-pressed="@(step == 1 ? "true" : "false")" @onclick="() => GoStep(1)">1 · @L["finder.step1"]</button>
        <button type="button" aria-pressed="@(step == 2 ? "true" : "false")" disabled="@(result is null)" @onclick="() => GoStep(2)">2 · @L["finder.step2"]</button>
        <button type="button" aria-pressed="@(step == 3 ? "true" : "false")" disabled="@(pins.Count == 0)" @onclick="() => GoStep(3)">3 · @L["finder.step3"]</button>
    </nav>

    @if (failed)
    {
        <p class="error page-note">@L["finder.noData"]</p>
    }
    else if (grid is null)
    {
        <p class="muted page-note">@L["finder.loading"]</p>
    }
    else if (step == 1)
    {
        <div class="finder-cols">
            <section class="finder-col">
                <div class="fgroup">
                    <span class="cap">@L["finder.profile"]</span>
                    <div class="chips">
                        @foreach (var key in ProfileKeys)
                        {
                            <button type="button" class="chip" aria-pressed="@(profileKey == key ? "true" : "false")" @onclick="() => ApplyProfile(key)">@L.Profile(key)</button>
                        }
                    </div>
                </div>
                <SectionHeader Title="@L["finder.dateHead"]" />
                <div class="frow">
                    <label class="ffield"><span>@L["finder.date"]</span><input type="date" @bind="landingDate" min="@grid.StartUtc.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" max="@grid.EndUtc.AddDays(-1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" /></label>
                    <label class="ffield short"><span>@L["finder.duration"]</span><span class="fin"><input type="number" min="1" max="60" @bind="durationDays" /><em>@L["finder.days"]</em></span></label>
                </div>
                <div class="fgroup">
                    <span class="cap">@L["finder.flex"]</span>
                    <div class="chips">
                        @foreach (var (value, key) in FlexOptions)
                        {
                            <button type="button" class="chip" aria-pressed="@(flexDays == value ? "true" : "false")" @onclick="() => flexDays = value">@L[key]</button>
                        }
                    </div>
                    <span class="muted small">@L.Format("finder.dataYear", L.ShortDate(grid.StartUtc), L.ShortDate(grid.EndUtc.AddDays(-1)))</span>
                </div>
                <SectionHeader Title="@L["finder.lander"]" />
                <div class="frow">
                    <label class="ffield short"><span>@L["finder.panels"]</span><span class="fin"><input type="number" min="1" step="10" @bind="panelW" /><em>W</em></span></label>
                    <label class="ffield short"><span>@L["finder.load"]</span><span class="fin"><input type="number" min="1" step="5" @bind="loadW" /><em>W</em></span></label>
                    <label class="ffield short"><span>@L["finder.battery"]</span><span class="fin"><input type="number" min="0" step="0.5" @bind="batteryKWh" /><em>kWh</em></span></label>
                </div>
                <div class="fderived">
                    <span class="cap">@L["finder.derived"]</span>
                    <dl class="ro left">
                        <div><dt>@L["finder.maxDark"]</dt><dd>@Hours(Lander.MaxDarkHours)</dd></div>
                        <div><dt>@L["finder.needSun"]</dt><dd>≥ @Pct(Lander.RequiredSunShare)</dd></div>
                    </dl>
                    <p class="muted small">@L["finder.landerNote"]</p>
                    @if (FinderPreset.All.FirstOrDefault(preset => preset.Key == profileKey) is { } shown && shown.Fits(Missions.Current with { PanelW = panelW, LoadW = loadW, BatteryWh = batteryKWh * 1000, DurationDays = durationDays, MinEarthShare = minEarth }))
                    {
                        <p class="muted small">@L["finder.lander." + shown.LanderKey] <a href="sources">@L["rec.sources"] ›</a></p>
                    }
                </div>
                <SectionHeader Title="@L["finder.target"]" />
                <div class="chips">
                    @foreach (var key in TargetKeys)
                    {
                        <button type="button" class="chip" aria-pressed="@(targetKey == key ? "true" : "false")" @onclick="() => SetTarget(key)">@L["finder.target." + key]</button>
                    }
                </div>
                <div class="frow">
                    @if (targetKey == "site")
                    {
                        <label class="ffield">
                            <span>@L["finder.targetSite"]</span>
                            <select @bind="targetSiteId">
                                @foreach (var site in PolarSites())
                                {
                                    <option value="@site.Id">@L.Name(site)</option>
                                }
                            </select>
                        </label>
                    }
                    <label class="ffield short"><span>@L["finder.range"]</span><span class="fin"><input type="number" min="1" max="50" @bind="rangeKm" /><em>@L["finder.km"]</em></span></label>
                </div>
            </section>
            <section class="finder-col center">
                <figure class="finder-preview">
                    <img src="img/finder/basemap.jpg" alt="" />
                    <figcaption class="muted small">@L["finder.mapNote"]</figcaption>
                </figure>
            </section>
            <section class="finder-col right">
                <SectionHeader Title="@L["finder.constraints"]" />
                <div class="fgroup end">
                    <span class="cap">@L["finder.maxSlope"]</span>
                    <div class="chips">
                        @foreach (var value in SiteFinder.SlopeOptions)
                        {
                            <button type="button" class="chip" aria-pressed="@(Math.Abs(maxSlope - value) < 1e-9 ? "true" : "false")" @onclick="() => maxSlope = value">≤ @value.ToString(CultureInfo.InvariantCulture)°</button>
                        }
                    </div>
                </div>
                <div class="fgroup end">
                    <span class="cap">@L["finder.minEarth"]</span>
                    <div class="chips">
                        @foreach (var value in SiteFinder.EarthOptions)
                        {
                            <button type="button" class="chip" aria-pressed="@(Math.Abs(minEarth - value) < 1e-9 ? "true" : "false")" @onclick="() => minEarth = value">≥ @Pct(value)</button>
                        }
                    </div>
                </div>
                <dl class="ro">
                    <div><dt>@L["finder.darkLimit"]</dt><dd>@L.Format("finder.darkFromBattery", Hours(Lander.MaxDarkHours))</dd></div>
                    <div><dt>@L["finder.area"]</dt><dd>@L["finder.areaValue"]</dd></div>
                </dl>
                <SectionHeader Title="@L["finder.weights"]" />
                <div class="wsliders">
                    @WeightRow("finder.w.sun", wSun, v => wSun = v)
                    @WeightRow("finder.w.earth", wEarth, v => wEarth = v)
                    @WeightRow("finder.w.water", wWater, v => wWater = v)
                    @WeightRow("finder.w.slope", wSlope, v => wSlope = v)
                    @WeightRow("finder.w.target", wTarget, v => wTarget = v)
                </div>
                <p class="muted small fnote">@L["finder.weightsNote"]</p>
                <div class="factions">
                    <button type="button" class="cta" disabled="@computing" @onclick="RunAsync">@(computing ? L["finder.computing"] : L["finder.search"]) ›</button>
                    <div class="action-row">
                        <button type="button" class="action" @onclick='() => ApplyProfile("water")'>@L["finder.reset"]</button>
                    </div>
                </div>
            </section>
        </div>
    }
    else if (step == 2 && result is not null)
    {
        <div class="fguide">
            <ol>
                <li>@L["finder.guide1"]</li>
                <li>@L["finder.guide2"]</li>
                <li>@L["finder.guide3"]</li>
            </ol>
            <button type="button" class="cta" disabled="@(pins.Count == 0)" @onclick="() => GoStep(3)">@L.Format("finder.compareN", pins.Count) ›</button>
        </div>
        <div class="finder-cols">
            <section class="finder-col">
                <div class="fgroup">
                    <span class="cap">@L["finder.profile"]</span>
                    <div class="chips">
                        @foreach (var key in ProfileKeys)
                        {
                            <button type="button" class="chip" aria-pressed="@(profileKey == key ? "true" : "false")" disabled="@computing" @onclick="() => QuickProfile(key)">@L.Profile(key)</button>
                        }
                    </div>
                </div>
                <div class="fsummary">
                    <span>@Summary()</span>
                    <button type="button" class="link" @onclick="() => GoStep(1)">@L["finder.refine"] ›</button>
                </div>
                <SectionHeader Title="@L["finder.filters"]" />
                <div class="fgroup">
                    <span class="cap">@L["finder.maxSlope"]</span>
                    @foreach (var option in slopeCounts)
                    {
                        <button type="button" class="fopt" aria-pressed="@(Math.Abs(maxSlope - option.Value) < 1e-9 ? "true" : "false")" @onclick="() => SetSlope(option.Value)"><i></i>≤ @option.Value.ToString(CultureInfo.InvariantCulture)° <em>@L.Format("finder.zonesN", option.Zones)</em></button>
                    }
                </div>
                <div class="fgroup">
                    <span class="cap">@L["finder.minEarth"]</span>
                    @foreach (var option in earthCounts)
                    {
                        <button type="button" class="fopt" aria-pressed="@(Math.Abs(minEarth - option.Value) < 1e-9 ? "true" : "false")" @onclick="() => SetEarth(option.Value)"><i></i>≥ @Pct(option.Value) <em>@L.Format("finder.zonesN", option.Zones)</em></button>
                    }
                </div>
                <div class="fgroup">
                    <span class="cap">@L["finder.darkLimit"]</span>
                    <span class="fopt static" aria-pressed="true"><i></i>@L.Format("finder.darkFromBattery", Hours(Lander.MaxDarkHours))</span>
                </div>
                <div class="fgroup">
                    <span class="cap">@L["finder.minArea"]</span>
                    <div class="chips">
                        @foreach (var cells in AreaOptions)
                        {
                            <button type="button" class="chip" aria-pressed="@(minZoneCells == cells ? "true" : "false")" @onclick="() => SetArea(cells)">@((cells * grid.CellKm * grid.CellKm).ToString("F0", CultureInfo.InvariantCulture)) км²</button>
                        }
                    </div>
                </div>
                <div class="fgroup">
                    <span class="cap">@L["finder.layer"]</span>
                    <div class="chips">
                        @foreach (var key in LayerKeys)
                        {
                            <button type="button" class="chip" aria-pressed="@(layer == key ? "true" : "false")" @onclick="() => SetLayer(key)">@L["finder.layer." + key]</button>
                        }
                    </div>
                </div>
            </section>
            <section class="finder-col center">
                <div class="finder-map">
                    <img src="img/finder/basemap.jpg" alt="" />
                    <canvas @ref="heat" class="heat"></canvas>
                    <canvas @ref="lines" class="lines"></canvas>
                    <div @ref="hit" class="hit" role="img" aria-label="@L["finder.legend"]"></div>
                    @foreach (var zone in LabelZones())
                    {
                        var (lx, ly) = CellPercent(zone.BestCell);
                        <span class="zone-label @(selZone == zone.Rank - 1 ? "on" : null)" style="left: @F(lx)%; top: @F(ly)%">Z@(zone.Rank)</span>
                    }
                </div>
                <p class="fhover">@HoverText()</p>
                <div class="flegend">
                    <span class="cap">@L[layer == "score" ? "finder.legend" : "finder.legend." + layer]</span>
                    <div class="flegend-bar"></div>
                    <div class="flegend-scale"><span>0</span><span>0.5</span><span>1</span></div>
                    <span class="flegend-fail"><i></i>@L["finder.legendFail"]</span>
                    <p class="muted small">@L["finder.mapNote"]</p>
                </div>
                <div class="finder-tray">
                    <div class="tray-head">
                        <span class="cap">@L["finder.compare"]</span>
                        @if (pins.Count > 0)
                        {
                            <button type="button" class="link" @onclick="() => GoStep(3)">@L["finder.compareGo"] ›</button>
                        }
                    </div>
                    @foreach (var pin in pins)
                    {
                        <div class="pin @(pin.Cell == selCell ? "current" : null)">
                            <button type="button" class="pin-main" @onclick="() => OnCellClick(pin.Cell)">
                                <strong>@pin.Label <span class="badge">@F2(result.Score[pin.Cell])</span></strong>
                                <span class="pin-stats"><span class="sun">@L.Format("explore.cardSun", Pct(result.Windows[pin.Cell].SunShare))</span><span class="earth">@L.Format("explore.cardEarth", Pct(result.Windows[pin.Cell].EarthShare))</span></span>
                            </button>
                            <button type="button" class="pin-x" aria-label="@L["explore.compareRemove"]" @onclick="() => Unpin(pin.Cell)">×</button>
                        </div>
                    }
                </div>
            </section>
            <section class="finder-col right">
                @if (selCell >= 0)
                {
                    var info = Info(selCell);
                    var zone = selZone is { } z ? result.Zones[z] : null;
                    <header class="freadout-head">
                        <span class="badge big">@F2(result.Score[selCell])</span>
                        <h1>@(zone is null ? L["finder.point"] : L.Format("finder.zone", zone.Rank))</h1>
                    </header>
                    <p class="fcoords">@L.Lat(info.Lat, 2) · @L.Lon(info.Lon, 1)@(zone is null ? null : " · " + L.Format("finder.rank", zone.Rank, result.Zones.Count))</p>
                    @if (result.Fail[selCell] != FinderFail.None)
                    {
                        <p class="ffail">@L["finder.fails"]: @FailText(result.Fail[selCell])</p>
                    }
                    <dl class="ro">
                        @if (zone is not null)
                        {
                            <div><dt>@L["finder.zoneArea"]</dt><dd>@zone.AreaKm2.ToString("F0", CultureInfo.InvariantCulture) км²</dd></div>
                            <div><dt>@L["finder.minMean"]</dt><dd>@F2(zone.MinScore) / @F2(zone.MeanScore)</dd></div>
                        }
                        <div><dt>@L["finder.toWater"]</dt><dd>@grid.WaterDistanceKm(selCell).ToString("F0", CultureInfo.InvariantCulture) @L["finder.km"]</dd></div>
                        <div><dt>@L["finder.bestStart"]</dt><dd>@L.ShortDate(grid.At(info.Window.StartStep))</dd></div>
                    </dl>
                    <SectionHeader Title="@L["finder.window"]" />
                    <Meter Label="@L["metric.sun"]" Fraction="info.Window.SunShare" Tone="sun" />
                    <Meter Label="@L["metric.earth"]" Fraction="info.Window.EarthShare" Tone="earth" />
                    <dl class="ro">
                        <div><dt>@L["finder.row.dark"]</dt><dd>@Hours(info.Window.LongestDarkHours)</dd></div>
                        <div><dt>@L["finder.row.slope"]</dt><dd>@grid.SlopeMedianDeg(selCell).ToString("F1", CultureInfo.InvariantCulture)° / @grid.SlopeHighDeg(selCell).ToString("F1", CultureInfo.InvariantCulture)°</dd></div>
                    </dl>
                    <SectionHeader Title="@L["finder.contrib"]" />
                    <Meter Label="@L["finder.w.sun"]" Fraction="info.Utility.Sun" Tone="sun" />
                    <Meter Label="@L["finder.w.earth"]" Fraction="info.Utility.Earth" Tone="earth" />
                    <Meter Label="@L["finder.w.water"]" Fraction="info.Utility.Water" Tone="earth" />
                    <Meter Label="@L["finder.w.slope"]" Fraction="info.Utility.Slope" Tone="sun" />
                    @if (wTarget > 0)
                    {
                        <Meter Label="@L["finder.w.target"]" Fraction="info.Utility.Target" Tone="sun" />
                    }
                    <SectionHeader Title="@L["finder.stability"]" />
                    <dl class="ro">
                        @if (zone is not null && stability is not null && stability.TryGetValue(zone.Rank - 1, out var share))
                        {
                            <div><dt>@L["finder.stable"]</dt><dd>@Pct(share)</dd></div>
                        }
                        <div><dt>@L["finder.miss2"]</dt><dd>@Pct(MissAt(selCell, 2))</dd></div>
                    </dl>
                    <div class="factions">
                        <button type="button" class="cta" disabled="@(pins.Count >= MaxPins || pins.Any(p => p.Cell == selCell))" @onclick="PinSelected">@L["finder.addCompare"] ›</button>
                        <div class="action-row">
                            <a class="action" href="@ExploreLink(selCell)">@L["finder.openExplore"]</a>
                        </div>
                    </div>
                }
                @if (result.Zones.Count == 0)
                {
                    <p class="notice">@L["finder.none"]</p>
                }
                else
                {
                    <details class="fzones" open="@(selCell < 0)">
                        <summary>@L.Format("finder.allZones", result.Zones.Count)</summary>
                        <ol>
                            @foreach (var zone in result.Zones.Take(30))
                            {
                                <li><button type="button" class="link @(selZone == zone.Rank - 1 ? "on" : null)" @onclick="() => OnCellClick(zone.BestCell)">Z@(zone.Rank) · @F2(zone.MaxScore) · @zone.AreaKm2.ToString("F0", CultureInfo.InvariantCulture) км² · @L.Lat(zone.LatitudeDeg, 1)</button></li>
                            }
                        </ol>
                    </details>
                }
            </section>
        </div>
    }
    else if (step == 3 && result is not null)
    {
        <div class="finder-report">
            <header class="freport-head">
                <div>
                    <h1>@L["finder.reportTitle"]</h1>
                    <p class="lede">@Summary()</p>
                </div>
                <div class="action-row">
                    <button type="button" class="action" @onclick="() => GoStep(2)">@L["finder.back"]</button>
                    <button type="button" class="action" @onclick="PrintAsync">@L["finder.print"]</button>
                </div>
            </header>
            <div class="fcards">
                @foreach (var pin in pins)
                {
                    var (pinId, pinStart) = PinSite(pin.Cell);
                    var (pinLat, pinLon) = grid.LatLon(pin.Cell);
                    <article class="fcard">
                        <header>
                            <h2>@pin.Label <span class="badge">@F2(result.Score[pin.Cell])</span></h2>
                            <p class="fcoords">@L.Lat(pinLat, 2) · @L.Lon(pinLon, 1) · @L.Format("finder.startOn", L.ShortDate(grid.At(result.Windows[pin.Cell].StartStep)))</p>
                        </header>
                        <div class="fcard-actions">
                            <a class="cta" href="@ReportLink(pin.Cell)">@L["finder.fullReport"] ›</a>
                            <a class="link" href="@ExploreLink(pin.Cell)">@L["finder.openExplore"] ›</a>
                        </div>
                        <RobustnessCard SiteId="@pinId" Start="pinStart" Compact="true" Bare="true" />
                    </article>
                }
            </div>
            <p class="muted small fcards-note">@L["finder.robustNote"] @L["robust.note"] <a href="plan/tipover">@L["robust.tip.more"] ›</a></p>
            <div class="freport-body">
                <section>
                    <SectionHeader Title="@L["finder.criteria"]" />
                    <table class="ftable">
                        <thead>
                            <tr><th></th>@foreach (var pin in pins) {
                                <th class="@(pin == pins[0] ? "lead" : null)">@pin.Label</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr><th>@L["finder.score"]</th>@foreach (var pin in pins) {
                            <td><span class="badge">@F2(result.Score[pin.Cell])</span></td>
                        }
                    </tr>
                    <tr><th>@L["finder.row.sun"]</th>@foreach (var pin in pins) {
                        <td class="@Bad(pin.Cell, FinderFail.Sun)">@Pct(result.Windows[pin.Cell].SunShare)</td>
                    }
                </tr>
                <tr><th>@L["finder.row.dark"]</th>@foreach (var pin in pins) {
                    <td class="@Bad(pin.Cell, FinderFail.Darkness)">@Hours(result.Windows[pin.Cell].LongestDarkHours)</td>
                }
            </tr>
            <tr><th>@L["finder.row.earth"]</th>@foreach (var pin in pins) {
                <td class="@Bad(pin.Cell, FinderFail.Earth)">@Pct(result.Windows[pin.Cell].EarthShare)</td>
            }
        </tr>
        <tr><th>@L["finder.row.slope"]</th>@foreach (var pin in pins) {
            <td class="@Bad(pin.Cell, FinderFail.Slope)">@grid.SlopeMedianDeg(pin.Cell).ToString("F1", CultureInfo.InvariantCulture)° / @grid.SlopeHighDeg(pin.Cell).ToString("F1", CultureInfo.InvariantCulture)°</td>
        }
    </tr>
    <tr><th>@L["finder.row.water"]</th>@foreach (var pin in pins) {
        <td>@grid.WaterDistanceKm(pin.Cell).ToString("F0", CultureInfo.InvariantCulture) @L["finder.km"]</td>
    }
</tr>
<tr><th>@L["finder.row.area"]</th>@foreach (var pin in pins) {
    <td>@(result.ZoneOf[pin.Cell] >= 0 ? result.Zones[result.ZoneOf[pin.Cell]].AreaKm2.ToString("F0", CultureInfo.InvariantCulture) + " км²" : "—")</td>
}
</tr>
<tr><th>@L["finder.row.rank"]</th>@foreach (var pin in pins) {
    <td>@(result.ZoneOf[pin.Cell] >= 0 ? L.Format("finder.rank", result.ZoneOf[pin.Cell] + 1, result.Zones.Count) : L["finder.notPass"])</td>
}
</tr>
<tr><th>@L["finder.row.start"]</th>@foreach (var pin in pins) {
    <td>@L.ShortDate(grid.At(result.Windows[pin.Cell].StartStep))</td>
}
</tr>
<tr><th></th>@foreach (var pin in pins) {
    <td><a class="button" href="@ReportLink(pin.Cell)">@L["finder.fullReport"] ›</a></td>
}
</tr>
</tbody>
</table>
<p class="muted small">@L["finder.failNote"]</p>
<label class="ffield">
    <span>@L["finder.reference"]</span>
    <select value="" @onchange="AddReference" disabled="@(pins.Count >= MaxPins)">
        <option value="">—</option>
        @foreach (var site in PolarSites())
        {
            <option value="@site.Id">@L.Name(site)</option>
        }
    </select>
</label>
<SectionHeader Title="@L["finder.stabilityChart"]" />
<div class="fbars">
    @foreach (var pin in pins)
    {
        var zoneIndex = result.ZoneOf[pin.Cell];
        var share = zoneIndex >= 0 && stability is not null && stability.TryGetValue(zoneIndex, out var s) ? s : 0;
        <div class="fbar"><span>@pin.Label</span><i><b style="width: @F(share * 100)%"></b></i><em>@(zoneIndex >= 0 ? Pct(share) : "—")</em></div>
    }
</div>
<p class="muted small">@L["finder.stabilityNote"]</p>
</section>
<section>
    <SectionHeader Title="@L["finder.dateChart"]" />
    <FinderChart Title="@L["finder.dateChart"]" XLabel="@L["axis.landingDate"]" YLabel="@L["axis.score"]" Series="DateSeries()" XMin="0" XMax="@((grid.EndUtc - grid.StartUtc).TotalDays)" YMin="0" YMax="1" XTicks="MonthTicks()" YTicks="ScoreTicks" Band="WindowBand()" />
    <p class="muted small">@L.Format("finder.dateNote", durationDays)</p>
    <SectionHeader Title="@L["finder.missChart"]" />
    <FinderChart Title="@L["finder.missChart"]" XLabel="@L["axis.missKm"]" YLabel="@L["axis.passShare"]" Series="MissSeries()" XMin="0" XMax="10" YMin="0" YMax="1" XTicks="MissTicks" YTicks="ShareTicks" Marks="MissMarks" />
    <p class="muted small">@L["finder.missNote"]</p>
</section>
</div>
<p class="muted small">@L["finder.limitNote"]</p>
</div>
    }
</div>

@code {
    private const int MaxPins = 3;

    private static readonly string[] ProfileKeys = FinderPreset.All.Select(preset => preset.Key).ToArray();
    private static readonly string[] TargetKeys = ["water", "site", "none"];
    private static readonly string[] LayerKeys = ["score", "sun", "earth", "slope", "water"];
    private static readonly int[] AreaOptions = [1, 3, 5];
    private static readonly (int Value, string Key)[] FlexOptions = [(0, "finder.flex0"), (7, "finder.flex7"), (15, "finder.flex15"), (183, "finder.flexYear")];
