    private static (double X, double Y) Polar(double azimuthDeg, double elevationDeg)
    {
        var r = (90 - elevationDeg) / 180 * 100;
        var a = azimuthDeg * Math.PI / 180;
        return (r * Math.Sin(a), -r * Math.Cos(a));
    }

    private string HoursUtc(double? hours) => hours is { } h && item is not null ? Utc(item.Incident.LandingUtc.AddHours(h)) : "—";

    private string Hours(Interval? i, bool utc) => i is null ? "—" : utc && item is not null
        ? Short(item.Incident.LandingUtc.AddHours(i.Median)) + " (" + Short(item.Incident.LandingUtc.AddHours(i.Low)) + " – " + Short(item.Incident.LandingUtc.AddHours(i.High)) + ")"
        : i.Median.ToString("F0", CultureInfo.InvariantCulture);

    private static string Short(DateTimeOffset t) => Round(t).ToString("MM-dd HH:mm", CultureInfo.InvariantCulture);

    private static DateTime Round(DateTimeOffset t) => new DateTime((t.UtcDateTime.Ticks + TimeSpan.TicksPerMinute / 2) / TimeSpan.TicksPerMinute * TimeSpan.TicksPerMinute, DateTimeKind.Utc);

    private static string Signed(double? v) => v is { } d ? d.ToString("+0;−0;0", CultureInfo.InvariantCulture) : "—";

    private static string Utc(DateTimeOffset t) => Round(t).ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";

    private static string Range(DateTimeOffset a, DateTimeOffset b) => a == b
        ? a.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
        : a.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " – " + b.UtcDateTime.ToString(a.Date == b.Date ? "HH:mm" : "MM-dd HH:mm", CultureInfo.InvariantCulture);

    private string Coord(double v, bool lat) => lat ? L.Lat(v, 4) : L.Lon(v, 4);

    private static string Deg(double? v) => v is { } d ? d.ToString("F0", CultureInfo.InvariantCulture) + "°" : "—";

    private static string Deg1(double v) => v.ToString("F1", CultureInfo.InvariantCulture) + "°";

    private static string Pct(double? v) => v is { } d ? (d * 100).ToString("F0", CultureInfo.InvariantCulture) + "%" : "—";

    private static string F(double v) => v.ToString("F1", CultureInfo.InvariantCulture);

    private static string Sentence(string? text) => string.IsNullOrEmpty(text) ? "" : char.ToUpperInvariant(text[0]) + text[1..];

    private static string Host(string url) => Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host : url;
}
