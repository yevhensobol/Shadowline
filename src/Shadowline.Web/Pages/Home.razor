    private const int RecCount = 3;

    private bool recOpen;
    private bool recBusy;
    private bool recFailed;
    private string recKey = FinderPreset.Water.Key;
    private FinderGrid? recGrid;
    private FinderResult? recResult;
    private IReadOnlyDictionary<int, double>? recStability;
    private DateTimeOffset? recDay;
    private DateTimeOffset? recPicked;
    private Shadowline.Core.Missions.Mission? recMission;

    private IEnumerable<FinderZone> RecZones() => recOpen && recResult is { } found ? found.Zones.Take(RecCount) : [];

