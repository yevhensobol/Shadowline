    private List<Group> Groups()
    {
        var text = query.Trim();
        var sites = Store.Catalog!.Sites
            .Where(site => !IsTest(site))
            .Where(site => text.Length == 0 || site.Name.Contains(text, StringComparison.OrdinalIgnoreCase) || (site.NameUk?.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false) || (site.Mission?.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false));
        var groups = new List<Group>
        {
            new("explore.group.pole", []),
            new("explore.group.apollo", []),
            new("explore.group.luna", []),
            new("explore.group.surveyor", []),
            new("explore.group.other", []),
            new("explore.group.test", []),
            new("explore.group.planned", []),
            new("explore.group.impact", []),
        };
        foreach (var site in sites)
        {
            var index = IsTest(site) ? 5
                : site.Id.StartsWith("plan-", StringComparison.Ordinal) ? 6
                : site.Id.StartsWith("impact-", StringComparison.Ordinal) ? 7
                : site.LatitudeDeg < -60 ? 0
                : site.Id.StartsWith("apollo", StringComparison.Ordinal) ? 1
                : site.Id.StartsWith("luna", StringComparison.Ordinal) ? 2
                : site.Id.StartsWith("surveyor", StringComparison.Ordinal) ? 3
                : 4;
            groups[index].Sites.Add(site);
        }

        return groups.Where(group => group.Sites.Count > 0).OrderBy(group => group.Key == "explore.group.test" ? 1 : 0).ToList();
    }

    private (double Lat, double Lon)? SearchPoint()
    {
        var parts = query.Split(',', StringSplitOptions.TrimEntries);
        if (parts.Length == 2
            && double.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var lat)
            && double.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var lon)
            && CustomSite.IsValid(lat, lon))
        {
            return (lat, lon > 180 ? lon - 360 : lon);
        }

        return null;
    }

