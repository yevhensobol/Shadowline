    private async Task StartReplay(HistoryEvent item)
    {
        if (await Store.LoadHistoryAsync(item) is not { } ephemeris || view is null)
        {
            return;
        }

        StopPlay();
        if (replay is null)
        {
            liveCursor = cursor;
        }

        replay = item;
        replayEph = ephemeris;
        cursor = item.Grid.IndexOf(item.LandingUtc);
        view = ViewFor(view.Site.Id);
        Refresh();
        UpdateUrl();
        if (globe is not null && !surface)
        {
            await globe.FlyToAsync(view.Site.LatitudeDeg, view.Site.LongitudeEastDeg, 600, 60);
        }
    }

    private void EndReplay()
    {
        if (replay is null)
        {
            return;
        }

        StopPlay();
        replay = null;
        replayEph = null;
        cursor = Math.Clamp(liveCursor, 0, Grid.Count - 1);
        if (view is not null)
        {
            view = ViewFor(view.Site.Id);
        }

        Refresh();
        UpdateUrl();
    }

    private bool recording;
    private bool recordFailed;

    private async Task Record()
    {
        if (globe is null || view is null || recording)
        {
            return;
        }

        recording = true;
        recordFailed = false;
        var wasPlaying = playing;
        if (!playing)
        {
            TogglePlay();
        }

        StateHasChanged();
        var title = routeMode && routeSummary is { LengthKm: > 0 } ? L["route.title"] : IsCustom ? customName ?? L["explore.custom"] : ShortName(view.Site);
        var lines = new List<string> { FormatLat(view.Site.LatitudeDeg) + ", " + FormatLon(view.Site.LongitudeEastDeg) };
        if (replay is not null)
        {
            lines.Insert(0, HistoryTitle(replay));
        }

        var id = new string(view.Site.Id.Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
        var result = await globe.RecordAsync(title, lines, $"shadowline-{id}-{Grid.At(cursor).ToString("yyyyMMdd-HHmm", CultureInfo.InvariantCulture)}", 12);
        if (!wasPlaying)
        {
            StopPlay();
        }

        recording = false;
        recordFailed = result is null;
        StateHasChanged();
    }

