    private async Task SetLayerNow(bool now)
    {
        layerNow = now;
        QueueNowMap();
        await Task.CompletedTask;
    }

    private void QueueNowMap()
    {
        nowDirty = true;
        if (!nowRunning)
        {
            _ = InvokeAsync(RunNowMapAsync);
        }
    }

    private async Task RunNowMapAsync()
    {
        nowRunning = true;
        try
        {
            while (nowDirty)
            {
                nowDirty = false;
                await SendNowMapAsync();
                await Task.Delay(150);
            }
        }
        finally
        {
            nowRunning = false;
        }
    }

    private async Task SendNowMapAsync()
    {
        if (globe is null)
        {
            return;
        }

        var wanted = layerNow && layer is "sun" or "earth";
        if (wanted && FinderData.Grid is null && !nowLoading)
        {
            nowLoading = true;
            StateHasChanged();
        }

        var finder = wanted ? await FinderData.LoadAsync() : null;
        if (nowLoading)
        {
            nowLoading = false;
            StateHasChanged();
        }

        var step = finder is null ? -1 : finder.StepAt(Grid.At(cursor));
        var shown = finder is not null && step >= 0 && step < finder.Steps;
        var key = shown ? step.ToString(CultureInfo.InvariantCulture) : "off";
        if (key != nowKey)
        {
            nowKey = key;
            await globe.SetNowMapAsync(shown ? PoleNow.Build(finder!, Grid.At(cursor)) : null, finder?.Size ?? 0, finder?.HalfExtentM ?? 0);
        }

        if (shown != nowShown)
        {
            nowShown = shown;
            StateHasChanged();
        }
    }

    private void Refresh()
    {
        if (view is null)
        {
            return;
        }

        QueueNowMap();

        var grid = Grid;
        var length = Math.Min(30 * 48, grid.Count - cursor);
        var metrics = WindowEvaluator.Evaluate(view.Tracks, grid, cursor, Math.Max(1, length));
        var points = new List<string>();
        var samples = 120;
        for (var k = 0; k <= samples; k++)
        {
            var index = Math.Min(grid.Count - 1, cursor + k * (30 * 48) / samples);
            var sun = view.At(index).Sun;
            var above = sun.ElevationDeg - view.Horizon.ElevationAt(sun.AzimuthDeg);
            var y = Math.Clamp(SparkZero - above * SparkScale, 1, SparkHeight - 1);
            points.Add((k == 0 ? "M" : "L") + Format(k * (double)SparkWidth / samples) + " " + Format(y));
        }

        var s = Eph.Sun(cursor);
        var e = Eph.Earth(cursor);
        var sunFromEarth = (s - e).Normalized();
        var moonFromEarth = (e * -1).Normalized();
        var lit = (int)Math.Round((1 + Vec3.Dot(sunFromEarth, moonFromEarth)) / 2 * 100);
        var now = view.At(cursor);
        RefreshPins();
        card = new Card(CountdownText("planner.sun", view.Tracks.SunVisible), CountdownText("planner.earth", view.Tracks.EarthVisible), string.Join(' ', points), metrics, lit, now.Sun.ElevationDeg, view.Horizon.ElevationAt(now.Sun.AzimuthDeg), now.Earth.ElevationDeg, view.Power(grid, cursor, Math.Max(1, length)), DsnPanel.Summarize(view.Tracks.EarthVisible, Comms.Dsn(Eph), grid.Step, cursor, Math.Max(1, length)), view.Thermal(grid, cursor, Math.Max(1, length)), now.Earth.RangeKm / 299792.458);
    }

    private string CountdownText(string prefix, BitTrack track)
    {
        var countdown = Countdown.At(track, cursor);
        if (countdown.StepsToChange is not { } steps)
        {
            return L[prefix + (countdown.Active ? ".up" : ".down")];
        }

        return L.Format(prefix + (countdown.Active ? ".sets" : ".rises"), L.Span(Grid.Step * steps));
    }

    private void SetCursor(int index)
    {
        StopPlay();
        cursor = Math.Clamp(index, 0, Grid.Count - 1);
        Refresh();
        UpdateUrl();
    }

    private void OnScrub(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            cursor = Math.Clamp(value, 0, Grid.Count - 1);
            Refresh();
        }
    }

    private void Jump(BitTrack track, bool forward, bool rising)
    {
        if (TrackNavigator.Find(track, cursor, forward, rising) is { } target)
        {
            cursor = target;
            Refresh();
            UpdateUrl();
        }
    }


    private async Task OnYear(ChangeEventArgs args)
    {
        if (args.Value?.ToString() is not { } id || view is null)
        {
            return;
        }

        StopPlay();
        var offset = Grid.At(cursor) - Grid.Start;
        if (!await Store.SetYearAsync(id))
        {
            return;
        }

        cursor = Math.Clamp(Grid.IndexOf(Grid.Start + offset), 0, Grid.Count - 1);
        view = ViewFor(view.Site.Id);
        Refresh();
        UpdateUrl();
    }

    private void OnSpeed(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value) && value >= 0 && value < Speeds.Length)
        {
            speedIndex = value;
        }
    }

    private void TogglePlay()
    {
        if (playing)
        {
            StopPlay();
            UpdateUrl();
            return;
        }

        playing = true;
        timer = new Timer(_ => InvokeAsync(Tick), null, TickMs, TickMs);
    }

    private void StopPlay()
    {
        playing = false;
        timer?.Dispose();
        timer = null;
    }

    private void Tick()
    {
        if (!playing)
        {
            return;
        }

        var last = Grid.Count - 1;
        cursor = Math.Min(cursor + Speeds[speedIndex], last);
        if (cursor >= last)
        {
            StopPlay();
        }

        Refresh();
        StateHasChanged();
    }

    private void UpdateUrl()
    {
        if (view is null)
        {
            return;
        }

        var history = replay is null ? Store.YearQuery : "&h=" + Uri.EscapeDataString(replay.Id);
        Navigation.NavigateTo($"?site={Uri.EscapeDataString(view.Site.Id)}&t={cursor}{history}{Missions.QuerySuffix}", new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private string CompareLink() => view is null ? "compare" : $"compare?a={Uri.EscapeDataString(view.Site.Id)}&t={cursor}{Store.YearQuery}";

    private string ReportLink() => view is null ? "report" : $"report?site={Uri.EscapeDataString(view.Site.Id)}&t={cursor}&w=720{Store.YearQuery}";

    private string PlannerLink() => view is null ? "plan/sky" : $"plan/sky?site={Uri.EscapeDataString(view.Site.Id)}&t={cursor}&w=168{Store.YearQuery}";

    private IEnumerable<(double Fraction, string Label)> Months()
    {
        var grid = Grid;
        var start = grid.Start;
        var month = new DateTimeOffset(start.Year, start.Month, 1, 0, 0, 0, TimeSpan.Zero).AddMonths(1);
        var total = (grid.End - grid.Start).TotalHours;
        if (total < 24 * 60)
        {
            var names = L.Language == "uk" ? MonthsUk : MonthsEn;
            var day = new DateTimeOffset(start.Year, start.Month, start.Day, 0, 0, 0, TimeSpan.Zero).AddDays(1);
            for (; day < grid.End; day = day.AddDays(5))
            {
                yield return ((day - start).TotalHours / total, day.Day.ToString(CultureInfo.InvariantCulture) + " " + names[day.Month - 1]);
            }

            yield break;
        }

        while (month < grid.End)
        {
            var names = L.Language == "uk" ? MonthsUk : MonthsEn;
            var label = names[month.Month - 1] + (month.Month <= 2 ? " " + month.Year.ToString(CultureInfo.InvariantCulture) : string.Empty);
            yield return ((month - start).TotalHours / total, label);
            month = month.AddMonths(2);
        }
    }

    private double LaneX(int steps) => (double)steps / Grid.Count * LaneWidth;

    private static string Format(double value) => value.ToString("F1", CultureInfo.InvariantCulture);

    private static string EarthPhasePath(double lit)
    {
        const double r = 11;
        var k = Math.Clamp(lit, 0, 1);
        var rx = Math.Abs(1 - 2 * k) * r;
        var sweep = k > 0.5 ? 1 : 0;
        return $"M0 {Format(-r)} A{Format(r)} {Format(r)} 0 0 1 0 {Format(r)} A{Format(rx)} {Format(r)} 0 0 {sweep} 0 {Format(-r)} Z";
    }

    private static string Deg(double value) => value.ToString("F1", CultureInfo.InvariantCulture) + "°";

    private static string Percent(double fraction) => (fraction * 100).ToString("F0", CultureInfo.InvariantCulture) + "%";

    private string FormatLat(double value) => L.Lat(value, 2);

    private string ShortLat(double value) => L.Lat(value, 1);

    private string FormatLon(double value) => L.Lon(value, 2);

    public override void Dispose()
    {
        StopPlay();
        base.Dispose();
    }
}
