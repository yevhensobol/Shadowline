    private async Task Snapshot()
    {
        if (globe is null || view is null || card is null)
        {
            return;
        }

        var time = Grid.At(cursor);
        var title = IsCustom ? customName ?? L["explore.custom"] : ShortName(view.Site);
        var lines = new List<string>
        {
            FormatLat(view.Site.LatitudeDeg) + ", " + FormatLon(view.Site.LongitudeEastDeg) + "    " + time.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC",
            card.Sun + "    " + card.Earth,
        };
        if (replay is not null)
        {
            lines.Insert(0, HistoryTitle(replay));
        }

        if (surface)
        {
            lines.Add(L.Format("snapshot.eye", eye));
        }

        if (routeMode && routeSummary is { LengthKm: > 0 } summary)
        {
            title = L["route.title"];
            lines =
            [
                L["route.length"] + " " + summary.LengthKm.ToString("F1", CultureInfo.InvariantCulture) + " " + L["common.unit.km"] + "    " + L["route.grade"] + " " + summary.MaxGradeDeg.ToString("F0", CultureInfo.InvariantCulture) + "°",
                L["route.sun"] + " " + Percent(summary.SunMin) + " / " + Percent(summary.SunMean) + "    " + L["route.earth"] + " " + Percent(summary.EarthMean),
            ];
        }

        var id = new string(view.Site.Id.Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
        await globe.SnapshotAsync(title, lines, $"shadowline-{id}-{time.ToString("yyyyMMdd-HHmm", CultureInfo.InvariantCulture)}.png");
    }

