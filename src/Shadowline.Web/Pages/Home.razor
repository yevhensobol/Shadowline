    private async Task ApplyTourStep()
    {
        if (Store.Tour?.Steps is not { } steps || tourIndex is not { } index || index < 0 || index >= steps.Count || globe is null)
        {
            return;
        }

        var step = steps[index];
        StopPlay();
        if ((step.Layer ?? "none") != layer)
        {
            await SetLayer(step.Layer ?? "none");
        }

        if (step.Time is { } time)
        {
            cursor = Math.Clamp(Grid.IndexOf(time), 0, Grid.Count - 1);
        }

        if (Views.Resolve(step.Site) is null)
        {
            return;
        }

        if (step.Site.StartsWith(CustomSite.Prefix, StringComparison.Ordinal))
        {
            await Views.PrepareAsync(step.Site);
        }

        view = ViewFor(step.Site);
        Refresh();
        StateHasChanged();
        var scene = step.Scene ?? "orbit";
        if (scene == "orbit")
        {
            if (surface)
            {
                await Leave();
            }

            await globe.FlyToAsync(view.Site.LatitudeDeg, view.Site.LongitudeEastDeg, view.Site.LatitudeDeg < -70 ? 2600 : 4600);
            return;
        }

        if (await globe.StandAsync(view.Site, eye, SurfaceLabels()))
        {
            surface = true;
            StateHasChanged();
            if (scene == "earth")
            {
                await globe.TurnToAsync("earth");
            }
            else if (scene == "sun")
            {
                await globe.TurnToAsync("sun");
            }
            else if (scene == "eclipse")
            {
                await globe.TurnToAsync("sun", 6);
            }
        }
    }

