    private async Task ToggleRec()
    {
        recOpen = !recOpen;
        if (recOpen)
        {
            await Missions.EnsureLoadedAsync();
            recKey = FinderPreset.Match(Missions.Current)?.Key ?? FinderPreset.Custom;
            await RunRec();
        }
    }

    private async Task RecPreset(string key)
    {
        var preset = FinderPreset.Get(key);
        await Missions.SetAsync(preset.Apply(Missions.Current));
        recKey = preset.Key;
        await RunRec();
    }

    private async Task RunRec()
    {
        recBusy = true;
        recFailed = false;
        StateHasChanged();
        recGrid = await FinderData.LoadAsync();
        if (recGrid is null)
        {
            recBusy = false;
            recFailed = true;
            recResult = null;
            return;
        }

        await Task.Delay(30);
        var mission = Missions.Current;
        var day = recPicked ?? RecLandingDay(recGrid);
        var preset = recKey == FinderPreset.Custom ? null : FinderPreset.Get(recKey);
        var result = SiteFinder.Evaluate(recGrid, FinderPreset.Profile(mission, preset, day), FinderPreset.MinZoneCells);
        await Task.Yield();
        recStability = SiteFinder.Stability(result);
        recResult = result;
        recDay = day;
        recMission = mission;
        recBusy = false;
    }

    private DateTimeOffset RecLandingDay(FinderGrid finder)
    {
        var day = new DateTimeOffset(Grid.At(cursor).UtcDateTime.Date, TimeSpan.Zero);
        return day < finder.StartUtc || day >= finder.EndUtc ? new DateTimeOffset(finder.StartUtc.UtcDateTime.Date.AddDays(120), TimeSpan.Zero) : day;
    }

    private string RecDateValue(FinderGrid finder) =>
        (recDay ?? recPicked ?? RecLandingDay(finder)).UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private async Task OnRecDate(ChangeEventArgs args)
    {
        if (recGrid is null || !DateTime.TryParseExact(args.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var picked))
        {
            return;
        }

        var day = new DateTimeOffset(DateTime.SpecifyKind(picked, DateTimeKind.Utc));
        if (day < recGrid.StartUtc || day >= recGrid.EndUtc)
        {
            return;
        }

        recPicked = day;
        await RunRec();
    }

    private async Task PickRec(FinderZone zone)
    {
        if (recGrid is null)
        {
            return;
        }

        var start = recGrid.At(zone.Window.StartStep);
        if (start >= Grid.Start && start < Grid.End)
        {
            StopPlay();
            cursor = Math.Clamp(Grid.IndexOf(start), 0, Grid.Count - 1);
        }

        await SelectPoint(zone.LatitudeDeg, zone.LongitudeEastDeg, true);
        customName = L.Format("rec.zone", zone.Rank);
    }

