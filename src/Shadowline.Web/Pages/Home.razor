    private bool IsCustom => view?.Site.Id.StartsWith(CustomSite.Prefix, StringComparison.Ordinal) == true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Store.LoadAsync();
            await Store.ApplyYearAsync(new Uri(Navigation.Uri));
            await Views.EnsureLoadedAsync();
        }
        catch (Exception exception) when (exception is DataFormatException or HttpRequestException)
        {
            error = exception.Message;
            return;
        }

        var grid = Store.Manifest!.Grid;
        cursor = Math.Clamp(grid.IndexOf(DateTimeOffset.UtcNow), 0, grid.Count - 1);
        string? historyId = null;
        var uri = new Uri(Navigation.Uri);
        var siteId = DefaultSite;
        foreach (var pair in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && parts[0] == "site")
            {
                siteId = Uri.UnescapeDataString(parts[1]);
            }
            else if (parts.Length == 2 && parts[0] == "t" && int.TryParse(parts[1], out var t))
            {
                cursor = Math.Clamp(t, 0, grid.Count - 1);
            }
            else if (parts.Length == 2 && parts[0] == "h")
            {
                historyId = Uri.UnescapeDataString(parts[1]);
            }
        }

        if (historyId is not null && Store.FindHistory(historyId) is { } item && await Store.LoadHistoryAsync(item) is { } ephemeris)
        {
            var t = cursor;
            liveCursor = Math.Clamp(grid.IndexOf(DateTimeOffset.UtcNow), 0, grid.Count - 1);
            replay = item;
            replayEph = ephemeris;
            cursor = new Uri(Navigation.Uri).Query.Contains("t=", StringComparison.Ordinal) ? Math.Clamp(t, 0, item.GridCount - 1) : item.Grid.IndexOf(item.LandingUtc);
        }

        if (Views.Resolve(siteId) is null)
        {
            siteId = DefaultSite;
        }

        if (replay is null && !uri.Query.Contains("site=", StringComparison.Ordinal) && !uri.Query.Contains("t=", StringComparison.Ordinal))
        {
            (siteId, cursor) = LitStart(grid, cursor);
        }

        if (replay is null && siteId.StartsWith(CustomSite.Prefix, StringComparison.Ordinal) && Views.TerrainFor(siteId) is null)
        {
            preparing = true;
            view = ViewFor(siteId);
            Refresh();
            StateHasChanged();
            await Views.PrepareAsync(siteId);
            preparing = false;
        }

        view = ViewFor(siteId);
        if (replay is null && !siteId.StartsWith(CustomSite.Prefix, StringComparison.Ordinal))
        {
            pinned.Add(siteId);
        }

        Refresh();
    }

    private (string SiteId, int Cursor) LitStart(Shadowline.Core.Time.TimeGrid grid, int now)
    {
        var horizon = Math.Min(grid.Count - now, (int)(TimeSpan.FromDays(30) / grid.Step));
        var best = Store.Catalog!.Sites
            .Where(site => site.LatitudeDeg <= -80 && !IsTest(site) && !site.Id.StartsWith("plan-", StringComparison.Ordinal) && Views.Resolve(site.Id) is not null)
            .Select(site => (site.Id, Tracks: Views.Get(site.Id).Tracks))
            .Where(item => horizon > 0 && item.Tracks.SunVisible[now])
            .Select(item => (item.Id, Share: item.Tracks.SunVisible.Slice(now, horizon).Fraction()))
            .OrderByDescending(item => item.Share)
            .FirstOrDefault();
        if (best.Id is not null)
        {
            return (best.Id, now);
        }

        var sunrise = TrackNavigator.Find(Views.Get(DefaultSite).Tracks.SunVisible, now, true, true);
        return (DefaultSite, sunrise is { } rise ? Math.Clamp(rise + (int)(TimeSpan.FromHours(6) / grid.Step), 0, grid.Count - 1) : now);
    }

