                    }
                </div>
                <div>
                    <h2>@L["report.eva.title"] <sup class="cite">@Cite("ochmo2023", "null2023", "vasavada2012")</sup></h2>
                    <dl class="report-facts">
                        <div><dt>@L.Format("report.eva.lowSun", ops.Eva.LowSunLimitDeg.ToString("F0", CultureInfo.InvariantCulture))</dt><dd>@Pct(ops.Eva.LowSunShare)</dd></div>
                        <div><dt>@L["report.eva.shadow"]</dt><dd>@(ops.Eva.ShadowFactorAtLanding is { } f ? L.Format("report.eva.shadowValue", f.ToString("F1", CultureInfo.InvariantCulture)) : "-")</dd></div>
                        <div><dt>@L.Format("report.eva.glare", ops.Eva.GlareConeDeg.ToString("F0", CultureInfo.InvariantCulture))</dt><dd>@(ops.Eva.RouteGlareShare is { } g ? Pct(g) : L["report.eva.noRoute"])</dd></div>
                        <div><dt>@L["report.eva.night"]</dt><dd>@Celsius(ops.Eva.NightK) (@ops.Eva.NightK.ToString("F0", CultureInfo.InvariantCulture) K)</dd></div>
