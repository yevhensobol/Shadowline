            </section>

            <section>
                <h2>@L["report.disp.title"] <sup class="cite">@Cite("viper2022")</sup></h2>
                <div class="report-two even">
                    <div>
                        <h3 class="numbers-head">@L["report.disp.time"]</h3>
                        <table class="report-table">
                            <thead><tr><th>@L["report.disp.shift"]</th><th>@L["metric.sun"]</th><th>@L["metric.darkness"]</th><th>@L["metric.earth"]</th></tr></thead>
                            <tbody>
                                <tr class="base"><td>0</td><td>@Pct(report.Sun.SunlitShare)</td><td>@L.Duration(TimeSpan.FromHours(report.Sun.LongestDarknessHours))</td><td>@Pct(report.Earth.VisibleShare)</td></tr>
