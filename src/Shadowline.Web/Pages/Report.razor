        <section>
            <h2>@L["report.month.title"] <sup class="cite">@Cite("de440", "iau2015", "dsn810")</sup></h2>
            @if (monthly is { Count: > 0 })
            {
                var years = monthly.Select(m => m.Year).Distinct().ToList();
                var names = L["windows.months"].Split(',');
                var firstMonth = monthly[0].Month;
                @foreach (var (title, pick) in MonthTables())
                {
                    <h3 class="numbers-head">@L[title]</h3>
                    <div class="results-wrap">
                        <table class="month-table">
                            <thead><tr><th>@L["report.month.year"]</th>@for (var m = 0; m < 12; m++) { <th>@names[(firstMonth - 1 + m) % 12]</th> }</tr></thead>
                            <tbody>
                                @foreach (var year in years)
                                {
                                    <tr>
                                        <th scope="row">@DataStore.YearLabel(year)</th>
                                        @foreach (var item in monthly.Where(m => m.Year == year))
                                        {
                                            var v = pick(item);
                                            <td style="--v: @v.ToString("F3", CultureInfo.InvariantCulture)" title="@L.Duration(TimeSpan.FromHours(item.LongestDarknessHours))">@((v * 100).ToString("F0", CultureInfo.InvariantCulture))</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <p class="muted small">@L["report.month.note"] @L.Format("report.month.summary", Pct(monthly.Average(m => m.SunlitShare)), L.Duration(TimeSpan.FromHours(monthly.Max(m => m.LongestDarknessHours))), Pct(monthly.Average(m => m.LinkShare)))</p>
            }
            else
            {
                <p class="muted">@L["report.month.loading"]</p>
            }
        </section>

        <section>
            <h2>@L["report.intervals"]</h2>
            <div class="report-tables">
                @foreach (var (title, list) in Tables())
                {
                    <table>
                        <caption>@L[title]</caption>
                        <thead><tr><th>@L["report.start"]</th><th>@L["report.end"]</th><th>@L["report.length"]</th></tr></thead>
                        <tbody>
                            @foreach (var item in expanded.Contains(title) ? list : list.Take(IntervalRows))
                            {
                                <tr><td>@Stamp(item.StartUtc)</td><td>@Stamp(item.EndUtc)</td><td>@L.Duration(TimeSpan.FromHours(item.Hours))</td></tr>
                            }
                            @if (list.Count > IntervalRows && !expanded.Contains(title))
                            {
                                <tr class="more-row"><td colspan="3"><button type="button" class="link-button" @onclick="() => expanded.Add(title)">@L.Format("report.moreRows", list.Count - IntervalRows)</button></td></tr>
                            }
                            @if (list.Count == 0)
                            {
                                <tr><td colspan="3" class="muted">@L["report.none"]</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <p class="muted small">@L["report.clip"]</p>
        </section>

        <section>
            <h2>@L["report.numbers.title"]</h2>
            <div class="report-two even">
                <div>
                    <h3 class="numbers-head sun">@L["report.path.sun"] <sup>@Cite("de440", "spice", "iau-nominal", "kopp2011")</sup></h3>
                    <dl class="report-facts">
                        <div><dt>@L["metric.sun"]</dt><dd>@Pct(report.Sun.SunlitShare), @Hours(report.Sun.SunlitHours)</dd></div>
                        <div><dt>@L["report.num.sunrises"]</dt><dd>@report.Sun.Sunrises / @report.Sun.Sunsets</dd></div>
                        <div><dt>@L["metric.darkness"]</dt><dd>@Hours(report.Sun.LongestDarknessHours)</dd></div>
                        <div><dt>@L["report.num.elevation"]</dt><dd>@Deg(report.Sun.MinElevationDeg) / @Deg(report.Sun.MeanElevationDeg) / @Deg(report.Sun.MaxElevationDeg)</dd></div>
                        <div><dt>@L["report.fig.sunAbove"]</dt><dd>@Deg(report.Sun.MaxAboveHorizonDeg)</dd></div>
                        <div><dt>@L["report.num.sunDistance"]</dt><dd>@report.Sun.MinDistanceAu.ToString("F5", CultureInfo.InvariantCulture) … @report.Sun.MaxDistanceAu.ToString("F5", CultureInfo.InvariantCulture) @L["report.unit.au"]</dd></div>
                        <div><dt>@L["report.num.irradiance"]</dt><dd>@report.Sun.MinIrradianceWm2.ToString("F1", CultureInfo.InvariantCulture) … @report.Sun.MaxIrradianceWm2.ToString("F1", CultureInfo.InvariantCulture) @L["report.unit.wm2"]</dd></div>
                        <div><dt>@L["report.num.sunDisc"]</dt><dd>@report.Sun.AngularDiameterDeg.ToString("F4", CultureInfo.InvariantCulture)°</dd></div>
                        <div><dt>@L["report.num.peak"]</dt><dd>@report.Power.PeakVerticalW.ToString("F0", CultureInfo.InvariantCulture) @L["report.unit.w"], @L["report.num.mean"] @report.Power.MeanVerticalW.ToString("F0", CultureInfo.InvariantCulture) @L["report.unit.w"]</dd></div>
                        <div><dt>@L["report.num.energy"]</dt><dd>@((report.Power.VerticalKWhPerDay * Days()).ToString("F1", CultureInfo.InvariantCulture)) / @((report.Power.HorizontalKWhPerDay * Days()).ToString("F1", CultureInfo.InvariantCulture)) @L["report.unit.kwh"]</dd></div>
                    </dl>
                </div>
                <div>
                    <h3 class="numbers-head earth">@L["report.path.earth"] <sup>@Cite("de440", "spice", "dsn810", "si2019")</sup></h3>
                    <dl class="report-facts">
                        <div><dt>@L["metric.earth"]</dt><dd>@Pct(report.Earth.VisibleShare), @Hours(report.Earth.VisibleHours)</dd></div>
                        <div><dt>@L["report.num.earthrises"]</dt><dd>@report.Earth.Earthrises / @report.Earth.Earthsets</dd></div>
                        <div><dt>@L["metric.gap"]</dt><dd>@Hours(report.Earth.LongestGapHours)</dd></div>
                        <div><dt>@L["report.num.elevation"]</dt><dd>@Deg(report.Earth.MinElevationDeg) / @Deg(report.Earth.MeanElevationDeg) / @Deg(report.Earth.MaxElevationDeg)</dd></div>
                        <div><dt>@L["report.num.azimuth"]</dt><dd>@Deg(report.Earth.MinAzimuthDeg) … @Deg(report.Earth.MaxAzimuthDeg)</dd></div>
                        <div><dt>@L["report.num.earthDistance"]</dt><dd>@Km(report.Earth.MinRangeKm) … @Km(report.Earth.MaxRangeKm) @L["common.unit.km"]</dd></div>
                        <div><dt>@L["report.num.earthDisc"]</dt><dd>@report.Earth.MinAngularDiameterDeg.ToString("F3", CultureInfo.InvariantCulture)° … @report.Earth.MaxAngularDiameterDeg.ToString("F3", CultureInfo.InvariantCulture)°</dd></div>
                        <div><dt>@L["report.num.phase"]</dt><dd>@Pct(report.Earth.IlluminatedFractionAtStart)</dd></div>
                        <div><dt>@L["report.fig.link"]</dt><dd>@Pct(report.Earth.DsnLinkShare), @L["dsn.gap"] @Hours(report.Earth.LongestLinkGapHours)</dd></div>
                        @foreach (var station in report.Earth.Stations)
                        {
                            <div><dt>@L.Format("report.num.station", L.Place(station.Name))</dt><dd>@Pct(station.MoonAbove10DegShare)</dd></div>
                        }
                        <div><dt>@L["dsn.delay"]</dt><dd>@report.Earth.SignalDelaySeconds.ToString("F3", CultureInfo.InvariantCulture) @L["common.unit.s"]</dd></div>
                    </dl>
                </div>
            </div>
            <p class="muted small">@L["report.num.note"]</p>
        </section>

        <section class="report-method">
            <h2>@L["report.method.title"]</h2>
            <div class="results-wrap">
                <table class="report-table method-table">
                    <thead><tr><th>@L["report.method.quantity"]</th><th>@L["report.method.how"]</th><th>@L["report.method.accuracy"]</th><th>@L["report.method.refs"]</th></tr></thead>
                    <tbody>
                        @foreach (var item in report.Provenance)
                        {
                            <tr>
                                <th scope="row">@L["report.quantity." + item.Quantity]</th>
                                <td>@MethodText(item)</td>
                                <td>@AccuracyText(item)</td>
                                <td class="refs">@Cite(item.References.ToArray())</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h2>@L["report.sources"]</h2>
            <ol class="report-refs">
                @foreach (var reference in report.References)
                {
                    <li>@reference.Citation @L.Note(reference) @if (References.Link(reference) is { } link)
                    {
                        @(" ")<a href="@link" target="_blank" rel="noopener">@(reference.Doi is { } doi ? "doi:" + doi : link)</a>
                    }</li>
                }
            </ol>
            <p class="muted small">@L.Format("report.source.grid", report.StepMinutes) @L["report.source.models"]</p>
            <p class="muted small">@L.Format("report.generated", Stamp(report.GeneratedUtc)) <a href="science/method">@L["nav.method"]</a></p>
            <p class="muted small report-link">@Navigation.Uri</p>
        </section>
    </article>
}

@code {
    private const int LaneWidth = 940;

    private string SiteTitle => view is not null && report is not null && view.Site.Id == report.Site.Id
        ? (view.Site.Id.StartsWith(CustomSite.Prefix, StringComparison.Ordinal) ? L["explore.custom"] : L.Name(view.Site))
        : report?.Site.Name ?? string.Empty;

    private static readonly HashSet<string> Unrelated = ["csa-moon", "csa-rover", "ispace2021", "space2026", "pedregosa2011"];

    private static bool Cited(string id, Site site) => id switch
    {
        _ when Unrelated.Contains(id) => false,
        "santorelli2026" or "lunarrf2026" => site.LatitudeDeg <= -80,
        "nokia2025" => site.Id == "im2-athena",
        "henriksen2017" => site.Id is "im1-odysseus" or "im2-athena",
        "bandfield2011" => site.RockAbundance is not null,
        _ => true,
    };
    private const int IntervalRows = 8;

    private readonly HashSet<string> expanded = [];
    private readonly CancellationTokenSource cancel = new();
    private TerrainPatch? patch;
    private ReportDispersion? dispersion;
    private bool dispersionBusy;
    private IReadOnlyList<ReportMonth>? monthly;
    private double? mlPercentile;
    private Shadowline.Core.Thermal.DivinerCell? diviner;
    private Shadowline.Core.Thermal.RegolithResult? annual;
    private bool mlReady;

    private string? error;
    private SiteView? view;
    private SiteReport? report;
    private int start;
    private ReportRobustness? robustness;
    private ReportRadio? radio;
    private int length = 30 * 48;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Store.LoadAsync();
            await Store.ApplyYearAsync(new Uri(Navigation.Uri));
            await Views.EnsureLoadedAsync();
        }
        catch (Exception exception) when (exception is DataFormatException or HttpRequestException)
        {
            error = exception.Message;
            return;
        }

        var grid = Store.Manifest!.Grid;
        var state = PlannerState.Parse(new Uri(Navigation.Uri).Query);
        var siteId = state is not null && Views.Resolve(state.SiteId) is not null ? state.SiteId : Store.Catalog!.Sites[0].Id;
        start = Math.Clamp(state?.Cursor ?? 0, 0, grid.Count - 1);
        var hours = state?.WindowHours is > 0 and var h ? h : 720;
        length = Math.Clamp(hours * 60 / (int)grid.Step.TotalMinutes, 1, grid.Count - start);
        if (siteId.StartsWith(CustomSite.Prefix, StringComparison.Ordinal))
        {
            await Views.PrepareAsync(siteId);
        }

        view = Views.Get(siteId);
        var custom = siteId.StartsWith(CustomSite.Prefix, StringComparison.Ordinal);
        var source = !view.HasTerrain ? "flat" : custom ? (Views.UsesPoleTiles(siteId) ? "pole80" : Views.UsesPolarGrid(siteId) ? "polargrid" : "global") : view.Site.LatitudeDeg < -80 ? "polar" : "global";
        var route = Routes.BelongsTo(siteId) && Routes.Data is { Points: { Length: > 1 } points } && Routes.Summary is { } summary ? new ReportRoute(points, summary) : null;
        patch = await LoadPatchAsync(siteId);
        var site = custom && Views.TerrainFor(siteId) is { } terrain ? view.Site with { ElevationM = Math.Round(terrain.ElevationM, 1) } : view.Site;
        report = SiteReportBuilder.Build(site, source, view.Horizon, Store.Ephemeris!, view.Tracks, Comms.Dsn(Store.Ephemeris!), start, length, Store.Year ?? string.Empty, "MOON_ME", DateTimeOffset.UtcNow, route, patch);
        report = report with { References = report.References.Where(reference => Cited(reference.Id, site)).ToList() };
        dispersionBusy = patch is not null;
        _ = ExtrasAsync(cancel.Token);
    }

    private async Task<TerrainPatch?> LoadPatchAsync(string siteId)
    {
        try
        {
            if (Views.TerrainFor(siteId) is { } custom)
            {
                return TerrainPatch.Parse(custom.Tile);
            }

            if (siteId.StartsWith(CustomSite.Prefix, StringComparison.Ordinal))
            {
                return null;
            }

            using var response = await Http.GetAsync($"data/terrain/{Uri.EscapeDataString(siteId)}.bin");
            return response.IsSuccessStatusCode ? TerrainPatch.Parse(await response.Content.ReadAsByteArrayAsync()) : null;
        }
        catch (Exception exception) when (exception is HttpRequestException or ArgumentException)
        {
            return null;
        }
    }

    private async Task ExtrasAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(50, token);
            try
            {
                var map = PolarScoreMap.Parse(await Http.GetByteArrayAsync("data/pole_artemis.bin", token));
                mlPercentile = view is null ? null : map.Percentile(view.Site.LatitudeDeg, view.Site.LongitudeEastDeg);
            }
            catch (Exception exception) when (exception is HttpRequestException or ArgumentException)
            {
                mlPercentile = null;
            }

            mlReady = true;
            StateHasChanged();
            if (view is not null && view.Site.LatitudeDeg <= -75)
            {
                try
                {
                    var map = Shadowline.Core.Thermal.DivinerPolarMap.Parse(await Http.GetByteArrayAsync("data/pole_diviner.bin", token));
                    diviner = map.At(view.Site.LatitudeDeg, view.Site.LongitudeEastDeg);
                }
                catch (Exception exception) when (exception is HttpRequestException or ArgumentException)
                {
                    diviner = null;
                }

                if (diviner is not null)
                {
                    StateHasChanged();
                    await Task.Yield();
                    var tilt = patch?.Tilt(480) ?? (0, 0);
                    annual = Shadowline.Core.Thermal.Regolith1D.Run(new Shadowline.Core.Geometry.SiteFrame(view.Site), Store.Ephemeris!, view.Horizon, 0, Store.Ephemeris!.Grid.Count, null, 4, 2, tilt.SlopeDeg, tilt.AspectDeg);
                    StateHasChanged();
                }
            }
            if (patch is not null && view is not null)
            {
                dispersion = await MissionAnalysis.DispersionAsync(view.Site, view.Horizon, patch, Store.Ephemeris!, start, length, token);
                dispersionBusy = false;
                StateHasChanged();
                await Task.Yield();
            }

            var list = new List<ReportMonth>();
            foreach (var entry in Store.Years?.Years ?? [])
            {
                token.ThrowIfCancellationRequested();
                if (await Store.LoadYearAsync(entry, token) is not { } ephemeris || view is null)
                {
                    continue;
                }

                await Task.Yield();
                var tracks = SkyTracks.Build(view.Site, ephemeris, view.Horizon);
                list.AddRange(MissionAnalysis.Monthly(entry.Id, tracks, Comms.Dsn(ephemeris), ephemeris.Grid));
                await Task.Yield();
            }

            monthly = list;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private IEnumerable<(string Title, Func<ReportMonth, double> Pick)> MonthTables()
    {
        yield return ("report.month.sun", m => m.SunlitShare);
        yield return ("report.month.link", m => m.LinkShare);
    }

    private string Metres(double m) => m >= 1000 ? (m / 1000).ToString("F1", CultureInfo.InvariantCulture) + " " + L["common.unit.km"] : m.ToString("F0", CultureInfo.InvariantCulture) + " " + L["common.unit.m"];

    public override void Dispose()
    {
        cancel.Cancel();
        base.Dispose();
    }

    private RenderFragment Lane(int y, string label, IReadOnlyList<ReportInterval> intervals, string css) => __builder =>
    {
        <g>
            <text x="0" y="@(y + 9)" class="lane-label">@label</text>
            <rect x="0" y="@(y + 12)" width="@LaneWidth" height="10" rx="2" class="lane" />
            @foreach (var item in intervals)
            {
                <rect x="@X(item.StartUtc)" y="@(y + 12)" width="@W(item.Hours)" height="10" class="@css" />
            }
        </g>
    };

    private IEnumerable<(string Title, IReadOnlyList<ReportInterval> List)> Tables()
    {
        yield return ("report.table.sun", report!.SunIntervals);
        yield return ("report.table.earth", report.EarthIntervals);
        yield return ("report.table.link", report.LinkIntervals);
        yield return ("report.table.eclipse", report.EclipseIntervals);
    }

    private double Hours() => (report!.WindowEndUtc - report.WindowStartUtc).TotalHours;

    private double Days() => Hours() / 24.0;

    private IReadOnlyList<SeriesChart.Reference> TemperatureReferences()
    {
        var lines = new List<SeriesChart.Reference> { new(273.15, "0 °C") };
        if (diviner is { } d)
        {
            lines.Add(new SeriesChart.Reference(d.AnnualMaxK, L.Format("report.series.divinerMax", d.AnnualMaxK.ToString("F0", CultureInfo.InvariantCulture)), true));
        }

        return lines;
    }

    private static IReadOnlyList<SeriesChart.Band> NightBands(SiteReport r)
    {
        var bands = new List<SeriesChart.Band>();
        var cursor = r.WindowStartUtc;
        foreach (var day in r.SunIntervals)
        {
            if (day.StartUtc > cursor)
            {
                bands.Add(new SeriesChart.Band((cursor - r.WindowStartUtc).TotalHours, (day.StartUtc - r.WindowStartUtc).TotalHours));
            }

            cursor = day.EndUtc;
        }

        if (cursor < r.WindowEndUtc)
        {
            bands.Add(new SeriesChart.Band((cursor - r.WindowStartUtc).TotalHours, (r.WindowEndUtc - r.WindowStartUtc).TotalHours));
        }

        return bands;
    }

    private string Hours(double hours) => hours >= 48 ? L.Duration(TimeSpan.FromHours(hours)) + " (" + hours.ToString("F1", CultureInfo.InvariantCulture) + " " + L["common.unit.h"] + ")" : L.Duration(TimeSpan.FromHours(hours));

    private static string Km(double km) => km.ToString("N0", CultureInfo.InvariantCulture).Replace(",", " ", StringComparison.Ordinal);

    private string Cite(params string[] ids)
    {
        var numbers = ids.Select(id => report!.References.ToList().FindIndex(r => r.Id == id) + 1).Where(n => n > 0).OrderBy(n => n).ToList();
        return numbers.Count == 0 ? "-" : "[" + string.Join(", ", numbers) + "]";
    }

    private string MethodText(ReportProvenance item) => item.Quantity switch
    {
        "site" => report!.Site.CoordinateSource ?? L["report.method.siteCustom"],
        "horizon" => L["report.method.horizon." + report!.Site.HorizonSource],
        "elevation" when report!.Site.HorizonSource == "pole80" => L["report.method.elevation.pole80"],
        _ => L["report.method." + item.Quantity],
    };

    private string AccuracyText(ReportProvenance item) => item.Quantity switch
    {
        "horizon" => L["report.acc.horizon." + report!.Site.HorizonSource],
        "site" when report!.Site.CoordinateSource is null => L["report.acc.siteCustom"],
        "elevation" when report!.Site.HorizonSource == "pole80" => L["report.acc.elevation.pole80"],
        _ => L["report.acc." + item.Quantity],
    };

    private string X(DateTimeOffset moment) => ((moment - report!.WindowStartUtc).TotalHours / Hours() * LaneWidth).ToString("F1", CultureInfo.InvariantCulture);

    private string W(double hours) => Math.Max(0.6, hours / Hours() * LaneWidth).ToString("F1", CultureInfo.InvariantCulture);

    private string VerdictWhy(ReportVerdict verdict) => verdict.Topic switch
    {
        "power" => L.Format("report.why.power", Pct(verdict.Value)),
        "night" => L.Format("report.why.night", L.Duration(TimeSpan.FromHours(verdict.Value))),
        _ => L.Format("report.why.link", Pct(verdict.Value)),
    };

    private static string Trend(double better, double worse)
    {
        var tolerance = Math.Max(0.005, Math.Abs(worse) * 0.002);
        return better > worse + tolerance ? "up" : better < worse - tolerance ? "down" : null!;
    }

    private static string Pct(double fraction) => (fraction * 100).ToString("F0", CultureInfo.InvariantCulture) + "%";

    private static string Deg(double value) => Signed(value, "F1") + "°";

    private static string Signed(double value, string format) => value.ToString(format, CultureInfo.InvariantCulture).Replace("-", "−", StringComparison.Ordinal);

    private string PhotoCaption(Shadowline.Data.SitePhoto photo) => photo.Caption is { } caption && (caption.GetValueOrDefault(L.Language) ?? caption.GetValueOrDefault("en")) is { } text ? text : string.Empty;

    private Shadowline.Core.Missions.NacSlopeCheck? NacCheck() => report?.Site.Id switch
    {
        "im1-odysseus" => Shadowline.Core.Missions.NacSlopeChecks.All.FirstOrDefault(c => c.Key == "im1"),
        "im2-athena" => Shadowline.Core.Missions.NacSlopeChecks.All.FirstOrDefault(c => c.Key == "im2"),
        _ => null,
    };

    private void RadioComputed(Shadowline.Core.Radio.MastViewshed? viewshed)
    {
        radio = viewshed is null ? null : new ReportRadio(Shadowline.Core.Radio.MastViewshed.MastM, Shadowline.Core.Radio.MastViewshed.ReceiverM, Shadowline.Core.Radio.MastViewshed.RangeM / 1000, Math.Round(viewshed.EvaFraction, 4), Math.Round(viewshed.NearFraction, 4), Math.Round(viewshed.AreaKm2, 1));
    }

    private static string Celsius(double kelvin) => (kelvin - 273.15).ToString("F0", CultureInfo.InvariantCulture).Replace("-", "−", StringComparison.Ordinal) + " °C";

    private static string Stamp(DateTimeOffset moment) => moment.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";

    private string Lat(double value) => L.Lat(value, 4);

    private string Lon(double value) => L.Lon(value, 4);

    private string TipLink() => view is null ? "plan/tipover" : $"plan/tipover?site={Uri.EscapeDataString(view.Site.Id)}&t={start}{Store.YearQuery}";

    private string ExploreLink() => view is null ? "./" : $"./?site={Uri.EscapeDataString(view.Site.Id)}&t={start}{Store.YearQuery}";

    private string FileStem()
    {
        var id = new string(view!.Site.Id.Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
        return $"shadowline-{id}-{Store.Manifest!.Grid.At(start).ToString("yyyyMMdd-HHmm", CultureInfo.InvariantCulture)}";
    }

    private async Task Print()
    {
        await using var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/files.js");
        await module.InvokeVoidAsync("print");
    }

    private async Task DownloadJson()
    {
        if (report is null)
        {
            return;
        }

        await using var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/files.js");
        await module.InvokeVoidAsync("download", FileStem() + ".json", ReportJson.Write(report with { Robustness = robustness, Dispersion = dispersion, Monthly = monthly, Diviner = diviner is { } d ? new ReportDiviner(d.AnnualMaxK, d.AnnualAverage2cmK, d.IceDepthM, annual?.MaxK, annual?.Mean2cmK) : null, Radio = radio }), "application/json");
    }

    private async Task DownloadCsv()
    {
        if (view is null)
        {
            return;
        }

        var csv = SiteCsv.Build(view.Site, Store.Ephemeris!, view.Horizon, view.Tracks, Store.Manifest!.Grid, start, length);
        await using var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/files.js");
        await module.InvokeVoidAsync("download", FileStem() + ".csv", csv, "text/csv");
    }
}
