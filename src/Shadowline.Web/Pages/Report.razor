                {
                    <p class="ml-score"><strong>@((pct * 100).ToString("F0", CultureInfo.InvariantCulture))</strong><span>@L["report.ml.of100"]</span></p>
                    <p>@L.Format("report.ml.text", (pct * 100).ToString("F0", CultureInfo.InvariantCulture))</p>
