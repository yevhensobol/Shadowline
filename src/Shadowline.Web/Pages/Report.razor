                            <p class="muted small">@L.Format("report.disp.spread", Pct(disp.Points.Min(p => p.SunlitShare)), Pct(disp.Points.Max(p => p.SunlitShare)), L.Duration(TimeSpan.FromHours(disp.Points.Min(p => p.LongestDarknessHours))), L.Duration(TimeSpan.FromHours(disp.Points.Max(p => p.LongestDarknessHours))), Pct(disp.Points.Min(p => p.EarthShare)), Pct(disp.Points.Max(p => p.EarthShare)))</p>
                        }
