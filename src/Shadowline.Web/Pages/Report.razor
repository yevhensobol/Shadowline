@page "/report"
@using System.Globalization
@using Shadowline.Core.Permalink
@using Shadowline.Core.Reports
@using Shadowline.Core.Sites
@using Shadowline.Core.Terrain
@using Shadowline.Core.Ml
@using Shadowline.Core.Tracks
@using Shadowline.Web.Components
@inherits LocalizedComponent
@inject DataStore Store
@inject SiteViewCache Views
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject CommsCache Comms
@inject RouteStore Routes
@inject HttpClient Http

<PageTitle>@(report is null ? L["report.title"] : L["report.title"] + ": " + SiteTitle) - Shadowline</PageTitle>

@if (error is not null)
{
    <p class="error page-note">@error</p>
}
else if (report is null || view is null)
{
    <p class="muted page-note">@L["common.loading"]</p>
}
else
{
    var grid = Store.Manifest!.Grid;
    <article class="report">
        <div class="report-tools">
            <a class="button" href="@ExploreLink()">@L["report.back"]</a>
            <a class="button" href="@TipLink()">@L["report.tipRisk"]</a>
            <button type="button" class="primary" @onclick="Print">@L["report.print"]</button>
            <button type="button" @onclick="DownloadJson">@L["report.json"]</button>
            <button type="button" @onclick="DownloadCsv">@L["report.csv"]</button>
        </div>

        <header class="report-cover">
            <div class="cover-main">
                <p class="report-kicker">@L["report.kicker"]</p>
                <h1>@SiteTitle</h1>
                <p class="cover-meta">
                    <span>@Lat(report.Site.LatitudeDeg), @Lon(report.Site.LongitudeEastDeg)</span>
                    <span>@Signed(report.Site.ElevationM, "F0") @L["common.unit.m"]</span>
                    @if (L.Mission(view.Site) is { Length: > 0 } mission)
                    {
                        <span>@mission</span>
                    }
                </p>
                <p>@L.Format("report.window", Stamp(report.WindowStartUtc), Stamp(report.WindowEndUtc), L.Span(report.WindowEndUtc - report.WindowStartUtc))</p>
                @if (report.Site.CoordinateSource is { } coordSource)
                {
                    <p class="cover-source">@L["report.coordSource"] @coordSource @if (report.Site.CoordinateSourceUrl is { } coordUrl)
                    {
                        @(" ")<a href="@coordUrl" target="_blank" rel="noopener">@coordUrl</a>
                    }</p>
                }
                else
                {
                    <p class="cover-source">@L["report.method.siteCustom"]</p>
                }
                @if (report.Site.Id.StartsWith("plan-", StringComparison.Ordinal))
                {
                    <p class="notice">@L["explore.planned"]</p>
                }
                @if (report.Site.Id.StartsWith("impact-", StringComparison.Ordinal))
                {
                    <p class="notice">@L["explore.impact"]</p>
                }
            </div>
            <ul class="verdicts">
                @foreach (var verdict in report.Verdicts)
                {
                    <li class="verdict @verdict.Level">
                        <span class="verdict-topic">@L["report.verdict." + verdict.Topic]</span>
                        <strong>@L["report.level." + verdict.Level]</strong>
                        <span class="verdict-why">@VerdictWhy(verdict)</span>
                    </li>
                }
            </ul>
        </header>

        @if (Shadowline.Data.PhotosReader.Find(Store.Photos, report.Site.Id) is { } photo)
        {
            <figure class="site-photo report-photo">
                <a href="@photo.Source" target="_blank" rel="noopener"><img src="@photo.File" alt="@PhotoCaption(photo)" loading="lazy" /></a>
                <figcaption>@PhotoCaption(photo) <span class="muted">@photo.Credit</span></figcaption>
            </figure>
        }

        <section class="report-figures" aria-label="@L["report.figures"]">
            <div><strong>@Pct(report.Sun.SunlitShare)</strong><span>@L["metric.sun"]</span></div>
            <div><strong>@L.Duration(TimeSpan.FromHours(report.Sun.LongestDarknessHours))</strong><span>@L["metric.darkness"]</span></div>
            <div><strong>@Deg(report.Sun.MaxElevationDeg)</strong><span>@L["report.fig.sunMax"]</span></div>
            <div><strong>@Pct(report.Earth.DsnLinkShare)</strong><span>@L["report.fig.link"]</span></div>
            <div><strong>@L.Duration(TimeSpan.FromHours(report.Earth.LongestLinkGapHours))</strong><span>@L["dsn.gap"]</span></div>
            <div><strong>@report.Power.VerticalKWhPerDay.ToString("F1", CultureInfo.InvariantCulture)</strong><span>@L["report.fig.kwh"]</span></div>
            <div><strong>@report.Power.BatteryKWh.ToString("F0", CultureInfo.InvariantCulture)</strong><span>@L["report.fig.battery"]</span></div>
            <div><strong>@Celsius(report.Thermal.DayMaxK) / @Celsius(report.Thermal.NightK)</strong><span>@L["report.fig.temp"]</span></div>
        </section>

        <section class="report-robust">
            <RobustnessCard SiteId="@report.Site.Id" Start="start" ShowReport="false" Computed="r => robustness = r" />
        </section>

        @if (report.Mission is { } touchdown)
        {
            var land = touchdown.Landing;
            <section>
                <h2>@L["report.landing.title"] <sup class="cite">@Cite("de440", "jones1967", "ochmo2023")</sup></h2>
                <div class="report-two even">
                    <dl class="report-facts">
                        <div><dt>@L["report.landing.sunEl"]</dt><dd>@Deg(land.SunElevationDeg), @Deg(land.SunAzimuthDeg)</dd></div>
                        <div><dt>@L["report.landing.sunAbove"]</dt><dd>@Deg(land.SunAboveTerrainDeg)</dd></div>
                        <div><dt>@L["report.landing.disc"]</dt><dd>@Pct(land.SunDiscVisibleShare)</dd></div>
                        <div><dt>@L["report.landing.apollo"]</dt><dd class="@(land.ApolloLighting == "within" ? "ok" : "warn")">@L["report.apollo." + land.ApolloLighting]</dd></div>
                        <div><dt>@L["report.landing.earthEl"]</dt><dd>@Deg(land.EarthElevationDeg), @Deg(land.EarthAzimuthDeg)</dd></div>
                        <div><dt>@L["report.landing.earthAbove"]</dt><dd>@Deg(land.EarthAboveTerrainDeg)</dd></div>
                        <div><dt>@L["report.landing.link"]</dt><dd class="@(land.DsnLink ? "ok" : "warn")">@L[land.DsnLink ? "report.yes" : "report.no"]</dd></div>
                        <div><dt>@L["report.landing.stations"]</dt><dd>@(land.StationsInView.Count == 0 ? "-" : string.Join(", ", land.StationsInView.Select(L.Place)))</dd></div>
                    </dl>
                    <div>
                        <h3 class="numbers-head">@L["report.changes.title"]</h3>
                        <ul class="change-list">
                            @foreach (var change in touchdown.Changes)
                            {
                                var key = "report.change." + change.Topic + (change.AtLanding ? ".on" : ".off");
                                <li class="@change.Topic">@(change.HoursToChange is { } h ? L.Format(key, L.Duration(TimeSpan.FromHours(h))) : L[key + ".never"])</li>
                            }
                        </ul>
                        <h3 class="numbers-head">@L["report.landing.shadows"]</h3>
                        <table class="report-table">
                            <thead><tr><th>@L["report.shadow.object"]</th><th>@L["report.shadow.height"]</th><th>@L["report.shadow.length"]</th></tr></thead>
                            <tbody>
                                @foreach (var shadow in land.Shadows)
                                {
                                    <tr><td>@L["report.shadow." + shadow.Object]</td><td>@shadow.HeightM.ToString("F1", CultureInfo.InvariantCulture) @L["common.unit.m"]</td><td>@(shadow.LengthM is { } len ? Metres(len) : "-")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        }

        <section>
            <h2>@L["report.path.title"]</h2>
            <HorizonPathChart Horizon="view.Horizon" Path="report.Path" />
            <p class="muted small">@L["report.path.note"]</p>
        </section>

        @if (report.Series is { } ts)
        {
            var nights = NightBands(report);
            <section class="series-block">
                <h2>@L["report.series.title"] <sup class="cite">@Cite("de440", "hayne2017", "fincannon2020")</sup></h2>
                <p class="muted small">@L["report.series.lede"]</p>
                <SeriesChart Title="@L["report.series.elevation"]" YLabel="@L["axis.elevation"]" StepHours="ts.StepHours" Unit="°" ZeroLine="true" Bands="nights"
                             Lines="@(new SeriesChart.Line[] { new(L["report.path.sun"], ts.SunElevationDeg, "sun"), new(L["report.path.earth"], ts.EarthElevationDeg, "earth") })" />
                <SeriesChart Title="@L["report.series.temperature"]" YLabel="@L["axis.temperature"]" StepHours="ts.StepHours" Unit=" K" Bands="nights"
                             References="@TemperatureReferences()"
                             Lines="@(new SeriesChart.Line[] { new(L["report.series.surface"], ts.SurfaceK, "temp") })" />
                <SeriesChart Title="@L["report.series.power"]" YLabel="@L["axis.power"]" StepHours="ts.StepHours" Unit=" W" Min="0" Bands="nights"
                             References="@(new SeriesChart.Reference[] { new(ts.LoadW, L.Format("report.series.load", ts.LoadW.ToString("F0", CultureInfo.InvariantCulture))) })"
                             Lines="@(new SeriesChart.Line[] { new(L["report.series.tracking"], ts.TrackingW, "sun"), new(L.Format("report.series.fixed", ts.BestFixedAzimuthDeg.ToString("F0", CultureInfo.InvariantCulture)), ts.BestFixedW, "fixed") })" />
                <SeriesChart Title="@L["report.series.battery"]" YLabel="@L["axis.charge"]" StepHours="ts.StepHours" Unit="%" Min="0" Max="100" Bands="nights"
                             References="@(new SeriesChart.Reference[] { new(20, L["report.series.floor"]) })"
                             Lines="@(ts.Battery.Select((b, k) => new SeriesChart.Line(b.CapacityKWh.ToString("F0", CultureInfo.InvariantCulture) + " " + L["report.unit.kwh"], b.Soc.Select(v => v * 100).ToList(), "soc" + k)).ToList())" />
                <p class="muted small">@L["report.series.note"]@if (diviner is not null)
                {
                    @(" " + L["report.series.notePolar"])
                }</p>
            </section>
        }

        <section>
            <h2>@L["report.lanes"]</h2>
            <svg class="report-lanes" viewBox="-10 0 @(LaneWidth + 20) 122" role="img" aria-label="@L["report.lanes"]">
                @Lane(0, L["report.lane.sun"], report.SunIntervals, "lane-sun")
                @Lane(28, L["report.lane.earth"], report.EarthIntervals, "lane-earth")
                @Lane(56, L["report.lane.link"], report.LinkIntervals, "lane-link")
                @Lane(84, L["report.lane.eclipse"], report.EclipseIntervals, "lane-eclipse")
                @for (var day = 0; day * 24 <= Hours(); day += Math.Max(1, (int)(Hours() / 24 / 6)))
                {
                    <g>
                        <line x1="@X(report.WindowStartUtc.AddDays(day))" x2="@X(report.WindowStartUtc.AddDays(day))" y1="110" y2="114" class="lane-tick" />
                        <text x="@X(report.WindowStartUtc.AddDays(day))" y="122" class="lane-day">@day</text>
                    </g>
                }
            </svg>
            <p class="muted small">@L["report.days"]</p>
        </section>

        <section>
            <h2>@L.Format("report.sky", Stamp(report.WindowStartUtc))</h2>
            <SkyChart Snapshot="view.At(start)" Horizon="view.Horizon" />
        </section>

        <section class="report-two even">
            <div>
                <h2>@L["report.start.title"]</h2>
                <dl class="report-facts">
                    <div><dt>@L["explore.sunEl"]</dt><dd>@Deg(report.Sun.ElevationAtStartDeg)</dd></div>
                    <div><dt>@L["report.fig.sunAbove"]</dt><dd>@Deg(report.Sun.MaxAboveHorizonDeg)</dd></div>
                    <div><dt>@L["report.fig.sunMin"]</dt><dd>@Deg(report.Sun.MinElevationDeg)</dd></div>
                    <div><dt>@L["report.fig.earthRange"]</dt><dd>@Deg(report.Earth.MinElevationDeg) … @Deg(report.Earth.MaxElevationDeg)</dd></div>
                    <div><dt>@L["metric.earth"]</dt><dd>@Pct(report.Earth.VisibleShare)</dd></div>
                    <div><dt>@L["metric.gap"]</dt><dd>@L.Duration(TimeSpan.FromHours(report.Earth.LongestGapHours))</dd></div>
                    <div><dt>@L["metric.eclipse"]</dt><dd>@(report.Earth.EclipseCount == 0 ? L["report.none"] : L.Duration(TimeSpan.FromHours(report.Earth.EclipseHours)))</dd></div>
                    <div><dt>@L["dsn.delay"]</dt><dd>@L.Format("dsn.delayValue", report.Earth.SignalDelaySeconds.ToString("F2", CultureInfo.InvariantCulture), (2 * report.Earth.SignalDelaySeconds).ToString("F2", CultureInfo.InvariantCulture))</dd></div>
                </dl>
            </div>
            <div>
                <h2>@L["report.terrain.title"]</h2>
                <dl class="report-facts">
                    <div><dt>@L["report.terrain.source"]</dt><dd>@L["report.horizon." + report.Site.HorizonSource]</dd></div>
                    <div><dt>@L["report.terrain.max"]</dt><dd>@L.Format("report.terrain.maxValue", Deg(report.Horizon.MaxElevationDeg), report.Horizon.MaxAzimuthDeg.ToString("F0", CultureInfo.InvariantCulture))</dd></div>
                    <div><dt>@L["report.terrain.mean"]</dt><dd>@Deg(report.Horizon.MeanElevationDeg)</dd></div>
                    @if (view.Site.Id == report.Site.Id && view.Site.RockAbundance is { } rocks)
                    {
                        <div><dt>@L["explore.rocks"] <sup class="cite">@Cite("bandfield2011")</sup></dt><dd>@L.Format("explore.rocksValue", (rocks * 100).ToString("0.0#", CultureInfo.InvariantCulture))</dd></div>
                    }
                </dl>
                @if (view.Site.Id == report.Site.Id && view.Site.RockAbundance is not null)
                {
                    <p class="muted small">@L["explore.rocksHint"]</p>
                }
            </div>
        </section>

        <section class="report-three">
            <PowerPanel Estimate="report.Power" />
            <ThermalPanel Estimate="report.Thermal" Window="true" Tilted="patch is not null" />
            <DsnPanel Ephemeris="Store.Ephemeris!" Cursor="start" Link="new DsnPanel.LinkSummary(report.Earth.DsnLinkShare, TimeSpan.FromHours(report.Earth.LongestLinkGapHours))" DelaySeconds="report.Earth.SignalDelaySeconds" />
        </section>

        @if (report.Site.LatitudeDeg <= -80)
        {
            <section class="report-radio">
                <h2>@L["radio.title"] <sup class="cite">@Cite("santorelli2026", "lunarrf2026", "barker2023")</sup></h2>
                <RadioPanel SiteId="@report.Site.Id" LatitudeDeg="report.Site.LatitudeDeg" LongitudeDeg="report.Site.LongitudeEastDeg" Bare="true" Computed="RadioComputed" />
                <p class="muted small">@L["report.radio.note"] <a href="science/method#radio">@L["nav.method"]</a></p>
            </section>
        }

        <section>
            <h2>@L["report.regolith.title"] <sup class="cite">@Cite("hayne2017", "vasavada2012", "williams2017")</sup></h2>
            <dl class="report-facts two-col">
                <div><dt>@L["report.regolith.mean"]</dt><dd>@Celsius(report.Regolith.MeanSurfaceK) (@report.Regolith.MeanSurfaceK.ToString("F0", CultureInfo.InvariantCulture) K)</dd></div>
                <div><dt>@L["report.regolith.deep"]</dt><dd>@Celsius(report.Regolith.SubsurfaceK) (@report.Regolith.SubsurfaceK.ToString("F0", CultureInfo.InvariantCulture) K)</dd></div>
                <div><dt>@L["report.regolith.darkMin"]</dt><dd>@(report.Regolith.DarkMinK is { } b ? Celsius(b) + " (" + b.ToString("F0", CultureInfo.InvariantCulture) + " K)" : "-")</dd></div>
                <div><dt>@L["report.regolith.tilt"]</dt><dd>@L.Format("report.regolith.tiltValue", report.Regolith.SlopeDeg.ToString("F1", CultureInfo.InvariantCulture), report.Regolith.AspectDeg.ToString("F0", CultureInfo.InvariantCulture))</dd></div>
                <div><dt>@L["report.regolith.simple"]</dt><dd>@Celsius(report.Regolith.SimpleModelMaxK) (@report.Regolith.SimpleModelMaxK.ToString("F0", CultureInfo.InvariantCulture) K)</dd></div>
            </dl>
            @if (diviner is { } measured)
            {
                <h3 class="numbers-head">@L["report.diviner.title"] <sup class="cite">@Cite("paige2010")</sup></h3>
                <table class="report-table">
                    <thead><tr><th></th><th>@L["report.diviner.max"]</th><th>@L["report.diviner.avg"]</th></tr></thead>
                    <tbody>
                        <tr class="base"><td>@L["report.diviner.measured"]</td><td>@measured.AnnualMaxK.ToString("F0", CultureInfo.InvariantCulture) K</td><td>@measured.AnnualAverage2cmK.ToString("F0", CultureInfo.InvariantCulture) K</td></tr>
                        <tr><td>@L["report.diviner.model"]</td><td>@(annual is { } y ? y.MaxK.ToString("F0", CultureInfo.InvariantCulture) + " K" : L["common.loading"])</td><td>@(annual is { } z ? z.Mean2cmK.ToString("F0", CultureInfo.InvariantCulture) + " K" : L["common.loading"])</td></tr>
                    </tbody>
                </table>
                <p>@(measured.IceDepthM is { } ice ? (ice <= 0.001 ? L["report.diviner.iceSurface"] : L.Format("report.diviner.ice", ice.ToString("F2", CultureInfo.InvariantCulture))) : L["report.diviner.noIce"])</p>
                <p class="muted small">@L["report.diviner.note"] <a href="science/validation#thermal">@L["nav.validation"]</a></p>
            }
            <p class="muted small">@L["report.acc.thermal"]</p>
        </section>

        <section>
            <h2>@L["report.shift.title"]</h2>
            <table class="report-table">
                <thead><tr><th>@L["report.shift.days"]</th><th>@L["metric.sun"]</th><th>@L["metric.darkness"]</th><th>@L["metric.earth"]</th></tr></thead>
                <tbody>
                    <tr class="base"><td>0</td><td>@Pct(report.Sun.SunlitShare)</td><td>@L.Duration(TimeSpan.FromHours(report.Sun.LongestDarknessHours))</td><td>@Pct(report.Earth.VisibleShare)</td></tr>
                    @foreach (var shift in report.StartShifts)
                    {
                        <tr><td>@(shift.Days > 0 ? "+" : null)@shift.Days</td><td class="@Trend(shift.SunlitShare, report.Sun.SunlitShare)">@Pct(shift.SunlitShare)</td><td class="@Trend(report.Sun.LongestDarknessHours, shift.LongestDarknessHours)">@L.Duration(TimeSpan.FromHours(shift.LongestDarknessHours))</td><td class="@Trend(shift.EarthShare, report.Earth.VisibleShare)">@Pct(shift.EarthShare)</td></tr>
                    }
                </tbody>
            </table>
            <p class="muted small">@L["report.shift.note"]</p>
        </section>

        @if (report.Route is { } route && Routes.BelongsTo(report.Site.Id) && Routes.Data is { } data)
        {
            <section>
                <h2>@L["route.title"]</h2>
                <div class="report-two">
                    <div>
                        <dl class="report-facts">
                            <div><dt>@L["route.length"]</dt><dd>@route.Summary.LengthKm.ToString("F1", CultureInfo.InvariantCulture) @L["common.unit.km"]</dd></div>
                            <div><dt>@L["route.climb"]</dt><dd>+@route.Summary.ClimbM.ToString("F0", CultureInfo.InvariantCulture) / −@route.Summary.DescentM.ToString("F0", CultureInfo.InvariantCulture) @L["common.unit.m"]</dd></div>
                            <div><dt>@L["route.grade"]</dt><dd>@Deg(route.Summary.MaxGradeDeg)</dd></div>
                            <div><dt>@L["route.steep"]</dt><dd>@Pct(route.Summary.SteepFraction)</dd></div>
                            <div><dt>@L["route.sun"]</dt><dd>@Pct(route.Summary.SunMin) / @Pct(route.Summary.SunMean)</dd></div>
                            <div><dt>@L["route.dark"]</dt><dd>@route.Summary.DarkKm.ToString("F1", CultureInfo.InvariantCulture) @L["common.unit.km"]</dd></div>
                            <div><dt>@L["route.earth"]</dt><dd>@Pct(route.Summary.EarthMean)</dd></div>
                        </dl>
                        <table class="report-table narrow">
                            <thead><tr><th>#</th><th>@L["report.route.lat"]</th><th>@L["report.route.lon"]</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < route.Waypoints.Count; i++)
                                {
                                    <tr><td>@(i + 1)</td><td>@Lat(route.Waypoints[i][0])</td><td>@Lon(route.Waypoints[i][1])</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <RouteProfile Data="data" Width="460" />
                </div>
                <p class="muted small">@L["route.note"]</p>
            </section>
        }

        @if (report.Mission is { } ops)
        {
            <section>
                <h2>@L["report.mount.title"] <sup class="cite">@Cite("fincannon2020", "kopp2011")</sup></h2>
                <table class="report-table">
                    <thead><tr><th>@L["report.mount.layout"]</th><th>@L["report.mount.kwh"]</th><th>@L["report.mount.peak"]</th><th>@L["report.mount.dark"]</th><th>@L["report.mount.cell"]</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < ops.Mounts.Count; i++)
                        {
                            var mount = ops.Mounts[i];
                            <tr class="@(i == 0 ? "base" : null)"><td>@L.Format("report.mount." + i, mount.AzimuthDeg.ToString("F0", CultureInfo.InvariantCulture))</td><td>@mount.KWhPerDay.ToString("F2", CultureInfo.InvariantCulture)</td><td>@mount.PeakW.ToString("F0", CultureInfo.InvariantCulture) @L["report.unit.w"]</td><td>@L.Duration(TimeSpan.FromHours(mount.LongestDarkHours))</td><td>@Signed(mount.MaxCellC, "F0") °C</td></tr>
                        }
                    </tbody>
                </table>
                <p class="muted small">@L["report.mount.note"]</p>
            </section>

            <section class="report-two even">
                <div>
                    <h2>@L["report.battery.title"] <sup class="cite">@Cite("kopp2011", "viper2022")</sup></h2>
                    <table class="report-table">
                        <thead><tr><th>@L["report.battery.capacity"]</th><th>@L["report.battery.min"]</th><th>@L["report.battery.empty"]</th><th>@L["report.battery.emptyHours"]</th></tr></thead>
                        <tbody>
                            @foreach (var battery in ops.Batteries)
                            {
                                <tr><td>@battery.CapacityKWh.ToString("F0", CultureInfo.InvariantCulture) @L["report.unit.kwh"]</td><td class="@(battery.HoursToEmpty is not null ? "down" : null)">@Pct(battery.MinStateOfCharge)</td><td>@(battery.HoursToEmpty is { } e ? L.Duration(TimeSpan.FromHours(e)) : L["report.battery.never"])</td><td>@L.Duration(TimeSpan.FromHours(battery.HoursEmpty))</td></tr>
                            }
                        </tbody>
                    </table>
                    <p class="muted small">@L["report.battery.note"]</p>
                </div>
                <div>
                    <h2>@L["report.safe.title"] <sup class="cite">@Cite("viper2022")</sup></h2>
                    <dl class="report-facts">
                        <div><dt>@L["report.safe.dark"]</dt><dd>@Hours(ops.SafeHaven.DarkWithoutEarthHours)</dd></div>
                        <div><dt>@L["report.safe.per"]</dt><dd>@ops.SafeHaven.PerLunationHours.ToString("F1", CultureInfo.InvariantCulture) @L["common.unit.h"]</dd></div>
                        <div><dt>@L["report.safe.longest"]</dt><dd>@Hours(ops.SafeHaven.LongestHours)</dd></div>
                        <div><dt>@L["report.safe.limit"]</dt><dd>@ops.SafeHaven.LimitHoursPerLunation.ToString("F0", CultureInfo.InvariantCulture) @L["common.unit.h"]</dd></div>
                    </dl>
                    <p class="pill @(ops.SafeHaven.Status switch { "pass" => "good", "short" => "limited", _ => "poor" })">@L["report.safe." + ops.SafeHaven.Status]</p>
                </div>
            </section>

            <section class="report-two even">
                <div>
                    <h2>@L["report.slope.title"] <sup class="cite">@Cite(report.Site.HorizonSource is "polar" or "polargrid" or "pole80" ? "barker2023" : "lola2017", "viper2022")</sup></h2>
                    @if (ops.Slope is { } slope)
                    {
                        <dl class="report-facts">
                            <div><dt>@L["report.slope.site"]</dt><dd>@Deg(slope.AtSiteDeg)</dd></div>
                            <div><dt>@L.Format("report.slope.mean", Metres(slope.RadiusM))</dt><dd>@Deg(slope.MeanDeg)</dd></div>
                            <div><dt>@L.Format("report.slope.max", Metres(slope.RadiusM))</dt><dd>@Deg(slope.MaxDeg)</dd></div>
                            <div><dt>@L.Format("report.slope.steep", slope.ThresholdDeg.ToString("F0", CultureInfo.InvariantCulture))</dt><dd class="@(slope.SteepShare > 0 ? "warn" : "ok")">@Pct(slope.SteepShare)</dd></div>
                            <div><dt>@L["report.slope.baseline"]</dt><dd>@Metres(slope.BaselineM)</dd></div>
                            @if (NacCheck() is { } nac)
                            {
                                <div><dt>@L.Format("report.slope.nac", nac.Product) <sup class="cite">@Cite("henriksen2017")</sup></dt><dd>@L.Format("report.slope.nacValue", Deg(nac.NacMedianDeg), Metres(nac.FineBaselineM), Deg(nac.NacMedianWideDeg), Metres(nac.WideBaselineM))</dd></div>
                            }
