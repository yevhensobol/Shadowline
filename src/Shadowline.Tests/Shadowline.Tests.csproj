<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shadowline.Core\Shadowline.Core.csproj" />
    <ProjectReference Include="..\Shadowline.Data\Shadowline.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Shadowline.Web\wwwroot\data\*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\*.bin" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\*.gz" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\horizon\*.bin" Link="data\horizon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\terrain\*.bin" Link="data\terrain\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\dem\*.bin" Link="data\dem\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\pole\*.*" Link="data\pole\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\pole\80\*.gz" Link="data\pole\80\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\img\scene\pole_height.bin" Link="data\pole_height.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\history\*.bin" Link="data\history\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\years\*.bin" Link="data\years\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shadowline.Web\wwwroot\data\incidents\*.bin" Link="data\incidents\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>